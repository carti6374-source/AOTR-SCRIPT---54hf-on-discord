	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then
			d.CanCollide = false
			H.Cache.disabledParts[d] = true
		end
	end
	H.connect("NoclipAdd", char.DescendantAdded:Connect(function(d)
		if not H.Runtime.farming or not d:IsA("BasePart") then return end
		task.defer(function()
			if not d.Parent then return end
			d.CanCollide = false
			H.Cache.disabledParts[d] = true
		end)
	end))
	H.connect("NoclipWatch", task.spawn(function()
		while H.Runtime.farming do
			task.wait(0.5)
			for part in pairs(H.Cache.disabledParts) do
				if part.Parent then pcall(function() part.CanCollide = false end)
				else H.Cache.disabledParts[part] = nil end
			end
		end
	end))
