function H.Colossal.erenPos()
	local node = H.safeIndex(workspace, "Unclimbable", "Objective")
	if not node then return nil end
	for _, child in ipairs(node:GetChildren()) do
		if child.Name:match("^Defend_Eren") then
			local ok, pos = pcall(nodePosition, child)
			if ok and pos then return pos end
		end
	end
	return nil
end

function H.Colossal.cannons()
	local boss = H.Colossal.boss()
	local bossPos = boss and boss.PrimaryPart and boss.PrimaryPart.Position
	local _, root = H.Char.get()
	local rootPos = root and root.Position
	local out = {}
	for _, cannon in ipairs(CS:GetTagged("Cannon")) do
		local base = cannon:FindFirstChild("Base")
		if base then
			local owner = cannon:GetAttribute("Player")
			if not owner or owner == REAL_NAME then
				local fromBoss = bossPos and (bossPos - base.Position).Magnitude or 0
				if not bossPos or fromBoss <= H.Colossal.MOUNT_RADIUS then
					out[#out + 1] = { inst = cannon, part = base, dist = rootPos and (rootPos - base.Position).Magnitude or 0 }
				end
			end
		end
	end
	table.sort(out, function(a, b) return a.dist < b.dist end)
	return out
end

function H.Colossal.rotationLock(on)
	if on then
		if H.Conn.ColossalRot then return end
		H.connect("ColossalRot", RunService.Heartbeat:Connect(function()
			local _, root, hum = H.Char.get()
			if hum and hum.AutoRotate then hum.AutoRotate = false end
			local bg = root and root:FindFirstChild("BG")
			if bg and bg:IsA("AlignOrientation") and bg.Enabled then bg.Enabled = false end
		end))
		return
	end
	H.disconnect("ColossalRot")
	local _, root, hum = H.Char.get()
	if hum then hum.AutoRotate = true end
	local bg = root and root:FindFirstChild("BG")
	if bg and bg:IsA("AlignOrientation") then bg.Enabled = true end
end

function H.Colossal.installVFXGuard()
	local template = H.safeIndex(RS, "Assets", "Particles", "Cannon", "Explosion")
	if template then
		local n = 0
		for _, d in ipairs(template:GetDescendants()) do
			if d:IsA("ParticleEmitter") then d:Destroy() n = n + 1
			elseif d:IsA("Light") then d.Enabled = false d.Brightness = 0 end
		end
		if n > 0 then H.log("vfx guard stripped " .. n) end
	end
	local debris = H.safeIndex(RS, "Assets", "Objects", "Template_Debris")
	if debris and debris:IsA("BasePart") then
		debris.Transparency = 1
		debris.CastShadow = false
	end
end

function H.Colossal.fireCycle(cannon)
	if not cannon or H.Colossal._firing or not cannon:FindFirstChild("Base") then return end
	H.Colossal._firing = true
	H.Colossal._cycles = H.Colossal._cycles + 1
	local cycle = H.Colossal._cycles
	task.delay(15, function()
		if H.Colossal._firing and H.Colossal._cycles == cycle then H.Colossal._firing = false end
	end)

	task.spawn(function()
		local function done(reason)
			H.log("colossal cycle #" .. cycle .. ": " .. reason)
			H.Colossal._firing = false
		end
		local deadline = os.clock() + 4
		while cannon.Parent and (cannon:GetAttribute("Cooldown") ~= nil or cannon:GetAttribute("Firing") ~= nil) do
			if os.clock() > deadline then return done("skip:cooldown") end
			task.wait(0.1)
		end
		if not cannon.Parent then return done("skip:despawn") end
		local _, root = H.Char.get()
		if not root then return done("skip:no_root") end

		H.Net.get("Cannon", "Claim", { args = { cannon }, timeout = 5 })
		H.Net.get("Cannon", "State", { args = { cannon, true }, timeout = 5 })
		local mountDeadline = os.clock() + 3
		while not root:FindFirstChild("Cannon") do
			if os.clock() > mountDeadline then return done("skip:no_mount") end
			task.wait(0.05)
		end
		H.Net.get("Cannon", "Shoot", { args = { { Base = 0, BarrelWood = 40 } }, timeout = 6 })

		local boss = H.Colossal.boss()
		local bossPos = boss and boss.PrimaryPart and boss.PrimaryPart.Position
		if not bossPos then return done("skip:no_boss_pos") end

		local projectile
		for _ = 1, 20 do
			for _, child in ipairs(workspace:GetChildren()) do
				if child.Name == "Cannon" and child:IsA("Model") and child:GetAttribute("Player") == REAL_NAME then
					projectile = child
					break
				end
			end
			if projectile then break end
			task.wait(0.1)
		end
		if not projectile then return done("skip:no_projectile") end

		projectile:SetAttribute("MH_Cycle", cycle)
		if not projectile.Parent and getnilinstances then
			for _, v in ipairs(getnilinstances()) do
				if v.Name == "Cannon" and v:GetAttribute("MH_Cycle") == cycle then projectile = v break end
			end
		end
		if not projectile then return done("skip:projectile_lost") end
		for _ = 1, 10 do H.Net.fire(H.REMOTE.POST, "S_Skills", "Impact", projectile, bossPos) end

		local fireDeadline = os.clock() + 5
		while cannon.Parent and cannon:GetAttribute("Firing") ~= nil do
			if os.clock() > fireDeadline then return done("skip:firing_timeout") end
			task.wait(0.1)
		end

		local function dismount()
			H.Net.get("Cannon", "State", {
				args = { cannon, false, { SFX = {}, Object = cannon, Base = cannon.Base,
					BarrelWood = cannon.Barrel.BarrelWood, Angles = { Base = 0, BarrelWood = 0 }, Directions = {} } },
				timeout = 5,
			})
		end
		dismount()
		task.wait(0.1)
		local dmDeadline = os.clock() + 3
		while root.Parent and root:FindFirstChild("Cannon") do
			if os.clock() > dmDeadline then break end
			task.wait(0.1)
		end
		pcall(dismount)
		done("done")
	end)
end

function H.Colossal.startMonitor()
	if H.Conn.ColossalMonitor then return end
	H.connect("ColossalMonitor", task.spawn(function()
		while H.Runtime.farming do
			task.wait(0.5)
			local active = H.Colossal.active()
			local running = H.Tasks.ColossalRaid:isRunning()
			if active and not running then
				H.Colossal.installVFXGuard()
				H.Tasks.ColossalRaid:start()
			elseif not active and running then
				H.Tasks.ColossalRaid:stop()
			end
		end
		if H.Tasks.ColossalRaid:isRunning() then H.Tasks.ColossalRaid:stop() end
	end))
end

function H.Colossal.stopMonitor()
	H.disconnect("ColossalMonitor")
	if H.Tasks.ColossalRaid:isRunning() then H.Tasks.ColossalRaid:stop() end
end

