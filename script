H.task("WaveMonitor", function(self)
	local deadline = os.clock() + 60
	while not self.cancelled and os.clock() < deadline and workspace:GetAttribute("Type") ~= "Waves" do task.wait(1) end
	if self.cancelled or workspace:GetAttribute("Type") ~= "Waves" then return end

	local wavesNode = H.safeIndex(workspace, "Unclimbable", "Objective", "Waves")
	local clearance = RS:FindFirstChild("Objectives")
	clearance = clearance and clearance:FindFirstChild("Clearance")
	local shown, lastPhase, lastCount = false, wavesNode and wavesNode:GetAttribute("Phase"), clearance and clearance.Value or 0

	local function checkShow()
		if not wavesNode then return end
		local show = wavesNode:GetAttribute("Show") == true
		if show and not shown then
			shown = true
			task.spawn(function() H.Wave.handleVote(wavesNode:GetAttribute("Phase") or "?") end)
		elseif not show then shown = false end
	end
	local function checkPhase()
		if not wavesNode then return end
		local phase = wavesNode:GetAttribute("Phase")
		if phase ~= lastPhase then lastPhase = phase checkShow() end
	end
	local function checkCount()
		if not clearance then return end
		local value = clearance.Value or 0
		if value == lastCount then return end
		lastCount = value
		H.UI.waveStatus("Wave " .. tostring(value))
		if H.Config.WaveThreshold > 0 and value >= H.Config.WaveThreshold then
			H.notify("Wave", "Threshold reached, stopping", 4, "log-out")
			self.cancelled = true
			H.Tasks.Attack:stop()
			H.Tasks.Movement:stop()
		end
	end

	local c1, c2, c3
	if wavesNode then
		c1 = wavesNode:GetAttributeChangedSignal("Show"):Connect(checkShow)
		c2 = wavesNode:GetAttributeChangedSignal("Phase"):Connect(checkPhase)
		checkShow()
	end
	if clearance then c3 = clearance:GetPropertyChangedSignal("Value"):Connect(checkCount) end
	while not self.cancelled and H.isInGame() do
		if wavesNode then checkShow() end
		checkCount()
		task.wait(1)
	end
	if c1 then c1:Disconnect() end
	if c2 then c2:Disconnect() end
