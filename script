	local hit = titan:FindFirstChild("Hitboxes")
	hit = hit and hit:FindFirstChild("Hit")
	local nape = hit and hit:FindFirstChild("Nape")
	if not nape then
		hit = titan:FindFirstChild("Hit", true)
		nape = hit and hit:FindFirstChild("Nape")
	end
	if nape then napeCache[titan] = nape end
	return nape
end

function H.Target.attackable(titan)
	if not titan then return false end
	local state = titan:GetAttribute("State")
	return state ~= nil and state ~= "Roar" and state ~= "HeatWave"
end

H.Target.bossNape, H.Target.bossStamp = nil, 0

function H.Target.raidBossNape()
	local now = os.clock()
	if now - H.Target.bossStamp < H.T.BOSS_CACHE then
		local cached = H.Target.bossNape
		if cached and cached.Parent then return cached end
		return nil
	end
	H.Target.bossStamp = now
	H.Target.bossNape = nil

	local mode = workspace:GetAttribute("Type")
	if not (mode == "Raids" or (mode == "Waves" and H.Config.WaveKillBosses)) then return nil end

	local titans = workspace:FindFirstChild("Titans")
	if not titans then return nil end
	for _, titan in ipairs(titans:GetChildren()) do
		if titan:IsA("Model") and titan:FindFirstChildOfClass("Humanoid")
			and not titan.Name:match("^%x+%-%x+%-%x+%-%x+%-%x+$")
			and titan:GetAttribute("State") ~= nil and titan.Name ~= "Colossal_Titan"
			and H.Colossal.phase() == 1 then
			local nape = H.Target.napeOf(titan)
			if nape and nape.Parent then H.Target.bossNape = nape return nape end
		end
	end
	return nil
end

function H.Target.smallTitanNape(origin)
	local titans = workspace:FindFirstChild("Titans")
	if not titans then return nil, nil end
	if not origin then
		local _, root = H.Char.get()
		if not root then return nil, nil end
		origin = root.Position
	end
	local best, bestTitan, bestDist = nil, nil, math.huge
	for _, titan in ipairs(titans:GetChildren()) do
		if titan:IsA("Model") and titan:FindFirstChildOfClass("Humanoid")
			and H.Target.attackable(titan) and titan.Name:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then
			local nape = H.Target.napeOf(titan)
			if nape and nape.Parent then
				local d = (origin - nape.Position).Magnitude
				if d < bestDist then best, bestTitan, bestDist = nape, titan, d end
			end
		end
	end
	return best, bestTitan
end

H.Target.bossHpPct, H.Target.bossHpStamp = nil, 0

function H.Target.raidBossHpPct()
	local now = os.clock()
	if now - H.Target.bossHpStamp < 0.4 then return H.Target.bossHpPct end
	H.Target.bossHpStamp = now
	H.Target.bossHpPct = nil

	local node = H.safeIndex(workspace, "Unclimbable", "Objective")
	if not node then return nil end
	local lowest
	for _, name in ipairs(H.BOSS_HP_NAMES) do
		local entry = node:FindFirstChild(name)
		if entry then
			local health = entry:FindFirstChild("Health")
			local value, max
			if health and health:IsA("NumberValue") then
				value, max = health.Value, health:GetAttribute("Max_Health")
			end
			if not value then
				local hum = entry:FindFirstChildOfClass("Humanoid")
				if hum then value, max = hum.Health, hum.MaxHealth end
			end
			if value and max and max > 0 and value > 0 then
				local pct = value / max * 100
				if not lowest or pct < lowest then lowest = pct end
			end
		end
	end
	H.Target.bossHpPct = lowest
	return lowest
end

H.Target.objCache, H.Target.objStamp = nil, 0
H.Target.objPrev, H.Target.objPrevStamp = nil, 0
H.Target.objMoving, H.Target.focus = false, nil
H.Target.PRIORITY_RADIUS = 1000
local titanPosPrev = setmetatable({}, { __mode = "k" })

local function nodePosition(inst)
	if not inst then return nil end
	if inst:IsA("BasePart") then return inst.Position end
	local collider = inst:FindFirstChild("Collider") or inst:FindFirstChild("Hitbox") or inst:FindFirstChild("RootPart")
	if collider and collider:IsA("BasePart") then return collider.Position end
	if inst:IsA("Model") and inst.PrimaryPart then return inst:GetPivot().Position end
	local any = inst:FindFirstChildWhichIsA("BasePart", true)
	return any and any.Position or nil
end

local function collectNodes(root, filter, out)
	if not root then return end
	for _, child in ipairs(root:GetChildren()) do
		if filter(child) then
			local ok, pos = pcall(nodePosition, child)
			if ok and typeof(pos) == "Vector3" then out[#out + 1] = { pos = pos, inst = child } end
		end
	end
end

function H.Target.objectivePositions()
	local now = os.clock()
	if H.Target.objCache and now - H.Target.objStamp < H.T.OBJ_CACHE then return H.Target.objCache end

	local nodes = {}
	local unclimbable = workspace:FindFirstChild("Unclimbable")
	local objective = unclimbable and unclimbable:FindFirstChild("Objective")
	collectNodes(objective, function(c) return c.Name ~= "Waves" end, nodes)
	collectNodes(unclimbable, function(c)
		local n = c.Name:lower()
		return n:match("^supplies_c") or n:match("^thunderspear_supplies") or n == "plane"
	end, nodes)

	local tower
	pcall(function()
		for _, v in ipairs(CS:GetTagged("TS_Towers")) do
			if v.Parent and v.Name:lower():match("^watchtower_%d") then tower = v break end
		end
	end)
	if tower then
		local pos = nodePosition(tower)
		if pos then nodes[#nodes + 1] = { pos = pos, inst = tower } end
	end

	if #nodes > 0 and H.Target.objPrev and now - H.Target.objPrevStamp >= 0.3 then
		local moving = #H.Target.objPrev ~= #nodes
		if not moving then
			for i = 1, math.min(#H.Target.objPrev, #nodes) do
				if (H.Target.objPrev[i].pos - nodes[i].pos).Magnitude > H.T.OBJ_MOVE_DELTA then moving = true break end
			end
		end
		H.Target.objMoving = moving
	end
	H.Target.objPrev, H.Target.objPrevStamp = nodes, now
	H.Target.objCache, H.Target.objStamp = nodes, now
	return nodes
end

function H.Target.movingObjective()
	local nodes = H.Target.objectivePositions()
	if #nodes == 0 then return nil, false end
	for _, node in ipairs(nodes) do
		if node.inst == H.Target.focus then return node.pos, H.Target.objMoving end
	end
	local _, root = H.Char.get()
	if not root then return nodes[1].pos, H.Target.objMoving end
	local best, bestDist = nodes[1].pos, math.huge
	for _, node in ipairs(nodes) do
		local d = (root.Position - node.pos).Magnitude
		if d < bestDist then best, bestDist = node.pos, d end
	end
	return best, H.Target.objMoving
end

function H.Target.valid(titan, nape)
	if not (titan and nape and nape.Parent) then return false end
	if H.Colossal.active() then
		if titan == H.Colossal.boss() then return H.Colossal.phase() == 2 end
		local eren = H.Colossal.erenPos()
		if not eren then return true end
		return (nape.Position - eren).Magnitude <= H.Colossal.EREN_RADIUS
	end
	if H.Thunder.defendingSupplies() then
		local pos = H.Thunder.supplyPos()
		if not pos then return true end
		return (nape.Position - pos).Magnitude <= H.Thunder.SUPPLY_RADIUS
	end
	return true
end

function H.Target.nearest()
	local now = os.clock()
	if H.Cache.nearestTitan and now - H.Cache.nearestStamp < H.T.NAPE_CACHE then
		local titan, nape = H.Cache.nearestTitan, H.Cache.nearestNape
		if titan and titan.Parent and nape and nape.Parent and titan:FindFirstChildOfClass("Humanoid") then return titan, nape end
	end

	local titans = workspace:FindFirstChild("Titans")
	local _, root = H.Char.get()
	if not (titans and root) then return nil, nil end

	local nodes = H.Target.objectivePositions()
	local candidates, fbTitan, fbNape, fbDist = {}, nil, nil, math.huge

	for _, titan in ipairs(titans:GetChildren()) do
		if titan:IsA("Model") and titan:FindFirstChildOfClass("Humanoid") and H.Target.attackable(titan) then
			local nape = H.Target.napeOf(titan)
			if nape and H.Target.valid(titan, nape) then
				local pos = nape.Position
				candidates[#candidates + 1] = { titan = titan, nape = nape, pos = pos }
				local d = (root.Position - pos).Magnitude
				if d < fbDist then fbTitan, fbNape, fbDist = titan, nape, d end
			end
		end
	end

	local function commit(titan, nape)
		H.Cache.nearestTitan, H.Cache.nearestNape, H.Cache.nearestStamp = titan, nape, now
		return titan, nape
	end

	if #nodes == 0 then H.Target.focus = nil return commit(fbTitan, fbNape) end

	local function countNear(pos)
		local n = 0
		for _, c in ipairs(candidates) do
			if (pos - c.pos).Magnitude <= H.Target.PRIORITY_RADIUS then n = n + 1 end
		end
		return n
	end

	local bestNode, bestCount, bestHp, bestDist = nil, -1, math.huge, math.huge
	for _, node in ipairs(nodes) do
		local count = countNear(node.pos)
		local hp = math.huge
		local health = node.inst and node.inst:FindFirstChild("Health")
		if health and health:IsA("ValueBase") then hp = tonumber(health.Value) or math.huge end
		local d = (root.Position - node.pos).Magnitude
		if not bestNode or count > bestCount or (count == bestCount and hp < bestHp)
			or (count == bestCount and hp == bestHp and d < bestDist) then
			bestNode, bestCount, bestHp, bestDist = node, count, hp, d
		end
	end

	if not bestNode then H.Target.focus = nil return commit(fbTitan, fbNape) end

	local stick = false
	if H.Target.focus then
		local current
		for _, node in ipairs(nodes) do if node.inst == H.Target.focus then current = node break end end
		if current then
			local currentCount = countNear(current.pos)
			stick = currentCount > 0 and bestNode ~= current and currentCount * 2 + 1 <= bestCount
		end
	end
	if not stick then H.Target.focus = bestNode.inst end
	if not H.Target.focus then return commit(fbTitan, fbNape) end

	local focusPos
	for _, node in ipairs(nodes) do if node.inst == H.Target.focus then focusPos = node.pos break end end
	if not focusPos then H.Target.focus = nil return commit(fbTitan, fbNape) end

	local stallPlane = workspace:GetAttribute("Objective") == "Stall" and H.Target.focus.Name:lower() == "plane"
	local bestTitan, bestNape, bestScore, bestLocal = nil, nil, -math.huge, math.huge

	for _, c in ipairs(candidates) do
		local d = (focusPos - c.pos).Magnitude
		if d <= H.Target.PRIORITY_RADIUS then
			if stallPlane then
				if d < bestLocal then bestTitan, bestNape, bestLocal = c.titan, c.nape, d end
			else
				local prev = titanPosPrev[c.titan]
				local closing = 0
				if prev then
					local dt = now - prev.t
					if dt > 0.01 then closing = ((focusPos - prev.pos).Magnitude - d) / dt end
				end
				titanPosPrev[c.titan] = { pos = c.pos, t = now }
				local score = (1 - d / H.Target.PRIORITY_RADIUS) * 100 + closing * 2
				if score > bestScore then bestTitan, bestNape, bestScore = c.titan, c.nape, score end
			end
		end
	end
	if bestTitan then return commit(bestTitan, bestNape) end
	return commit(fbTitan, fbNape)
end

function H.Target.update()
	local titan, nape = H.Target.nearest()
	if titan ~= H.Runtime.currentTitan then H.Runtime.bossHitboxRotIdx = 0 end
	H.Runtime.currentTitan, H.Runtime.nape = titan, nape
end

