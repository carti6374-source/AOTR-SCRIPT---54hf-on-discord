function H.Spoof.installIndex()
	if H.Hook.active.SpoofIndex then return end
	H.Hook.install("SpoofIndex", "__index", function(self, key)
		local getter = IDENTITY[key]
		if getter and (self == LP or (typeof(self) == "Instance" and self:IsA("Player"))) then
			local value = getter()
			if value ~= nil then return value end
		end
		return H.Hook.call("SpoofIndex", self, key)
	end)
end

function H.Spoof.installNamecall()
	if H.Hook.active.SpoofCall then return end
	H.Hook.install("SpoofCall", "__namecall", function(self, ...)
		local ok, method = pcall(getnamecallmethod)
		if ok then
			if self == Players then
				if method == "GetUserIdFromNameAsync" and H.Config.SpoofUserId then
					return H.Spoof.userId()
				elseif method == "GetNameFromUserIdAsync" and H.Config.SpoofUserId then
					return H.Spoof.name()
				elseif method == "GetPlayerByUserId" and H.Config.SpoofUserId then
					local id = ...
					if id == H.Spoof.userId() then return LP end
				end
			elseif self == MarketplaceService then
				if (method == "UserOwnsGamePassAsync" or method == "UserOwnsAsset") and H.Config.SpoofGamepass then
					return true
				end
			elseif self == UIS then
				if method == "GetPlatform" and H.Config.SpoofPlatform then
					return H.Config.SpoofPlatformValue
				end
			elseif typeof(self) == "Instance" and self:IsA("Player") then
				if (method == "IsInGroup" or method == "GetRankInGroup") and H.Config.SpoofGroup then
					if method == "IsInGroup" then return true end
					return H.num(H.Config.SpoofGroupRank, 255)
				end
			end
		end
		return H.Hook.call("SpoofCall", self, ...)
	end)
end

function H.Spoof.install()
	if not H.Hook.available() then
		H.notify("Spoof", "Executor lacks metatable hooks", 5, "x-circle")
		return false
	end
	H.Spoof.installIndex()
	H.Spoof.installNamecall()
	return true
end

function H.Spoof.remove()
	H.Hook.restore("SpoofIndex")
	H.Hook.restore("SpoofCall")
end

function H.Spoof.anyActive()
	for _, key in ipairs({ "SpoofUserId", "SpoofAge", "SpoofName", "SpoofPremium", "SpoofVerified", "SpoofGamepass", "SpoofGroup", "SpoofPlatform" }) do
		if H.Config[key] then return true end
	end
	return false
end

function H.Spoof.apply()
	if H.Spoof.anyActive() then H.Spoof.install() else H.Spoof.remove() end
end

function H.Spoof.refresh()
