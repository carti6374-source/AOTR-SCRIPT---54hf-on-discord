H.Wave = {}

function H.Wave.vote() H.Net.fire(H.REMOTE.POST, "Waves", "Update") end

function H.Wave.upgradeGear()
	local weapon = LP:GetAttribute("Weapon") or H.Lobby.autoUpgradeWeapon
	local categories = H.Gear.CATEGORIES[weapon]
	if not categories then return false end
	local goldLabel = H.gui(H.PATH.GOLD)
	local gold = goldLabel and tonumber((tostring(goldLabel.Text):gsub(",", ""))) or 0
	if gold < 100 then return false end

	local order = {}
	for i, stat in ipairs(categories) do order[i] = stat end
	local upgrades = H.Stats.upgrades[weapon]
	if upgrades then table.sort(order, function(a, b) return (upgrades[a] or 0) < (upgrades[b] or 0) end) end

	local count = #order
	while count > 0 do
		local batch = {}
		for i = 1, count do batch[i] = order[i] end
		local ok, a = H.Net.get("Equipment", "Upgrade", { args = { batch }, timeout = 8 })
		if ok and a ~= nil then return true end
		count = count - 1
		if count > 0 then task.wait(1) end
	end
	return false
end

function H.Wave.buyUpgrade(name)
	local res = H.Net.actor("Waves", "Upgrade", { args = { { name } }, timeout = 5 })
	return res ~= nil and res.ok == true
end

function H.Wave.handleVote(phase)
	if not H.Runtime.farming or not H.Config.WaveAutoVote then return end
	if phase ~= "Start" then
		H.Wave.vote()
		if phase ~= "Skip" then return end
	else
		local since = os.clock() - (H.Runtime.sessionStartTick or 0)
		if since < 10 then task.wait(math.max(0, 5 - since)) end
		local waited = 0
		while H.Cutscene.active() and waited < 20 do task.wait(0.5) waited = waited + 0.5 end
		task.wait(5)
		H.Wave.vote()
		if phase ~= "Skip" then return end
	end

	local node = H.safeIndex(workspace, "Unclimbable", "Objective", "Waves")
	local waited = 0
	while node and node:GetAttribute("Show") == true and waited < 20 do task.wait(0.5) waited = waited + 0.5 end

	if H.Config.WaveAutoUpgradeGear then H.Wave.upgradeGear() end
	if not H.Config.WaveAutoBuyUpgrades then return end
	for _, name in ipairs(H.selection(H.Config.WaveSelectedUpgrades)) do
		task.wait(0.15)
		H.Wave.buyUpgrade(name)
	end
end

