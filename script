H.Conn = {}

function H.disconnect(key)
	local c = H.Conn[key]
	if not c then return end
	H.Conn[key] = nil
	pcall(function()
		if typeof(c) == "RBXScriptConnection" then c:Disconnect()
		elseif type(c) == "thread" then task.cancel(c)
		elseif type(c) == "table" and type(c.Disconnect) == "function" then c:Disconnect() end
	end)
end

function H.connect(key, conn) H.disconnect(key) H.Conn[key] = conn return conn end

H.Task = {}
H.Task.__index = H.Task

function H.Task.new(name, fn, cleanup)
	return setmetatable({ name = name, fn = fn, cleanup = cleanup, thread = nil, cancelled = false, _cleaned = false }, H.Task)
end

function H.Task:isRunning() return self.thread ~= nil end

function H.Task:cleanupOnce()
	if self._cleaned then return end
	self._cleaned = true
	if self.cleanup then H.guard("task.cleanup:" .. self.name, self.cleanup, self) end
end

function H.Task:start(...)
	if self.thread then return end
	local args = table.pack(...)
	self.cancelled = false
	self._cleaned = false
	self.thread = task.spawn(function()
		local ok, err = pcall(self.fn, self, table.unpack(args, 1, args.n))
		if not ok then H.warn("task[" .. self.name .. "]", err) task.spawn(H.Report.push, err, "task:" .. self.name) end
		self:cleanupOnce()
		self.thread = nil
	end)
end

function H.Task:stop()
	if not self.thread and self._cleaned then return end
	self.cancelled = true
	local th = self.thread
	self.thread = nil
	if th and th ~= coroutine.running() then pcall(task.cancel, th) end
	self:cleanupOnce()
end

H.Tasks = {}
function H.task(name, fn, cleanup)
	local t = H.Task.new(name, fn, cleanup)
	H.Tasks[name] = t
	return t
end

