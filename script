---------------------------------------------------------------------

H.AUTO_EXEC_SRC = [[loadstring(game:HttpGet("https://pastebin.com/raw/3XcQi2HQ"))()]]

function H.applyAutoExecute()
	if not queue_on_teleport_ then
		if H.Config.AutoExecute then H.notify("Auto Execute", "Executor lacks queue_on_teleport", 5, "x-circle") end
		return
	end
	pcall(queue_on_teleport_, H.Config.AutoExecute and H.AUTO_EXEC_SRC or "")
end

