function H.Colossal.phase()
	local boss = H.Colossal.boss()
	if boss then
		local phase = boss:GetAttribute("Phase")
		if phase == 1 or phase == 2 then return phase end
	end
	local objectives = RS:FindFirstChild("Objectives")
