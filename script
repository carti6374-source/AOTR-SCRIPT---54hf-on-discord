end)

H.task("ThunderObjective", function(self)
	local carried, phase = nil, "PICKUP"
	local attemptStamp, holdStamp, carriedPart

	local function nearestSupply(origin)
		local unclimbable = workspace:FindFirstChild("Unclimbable")
		local objective = unclimbable and unclimbable:FindFirstChild("Objective")
		local best, bestInst, bestDist = nil, nil, math.huge
		for _, root in ipairs({ objective, unclimbable, workspace }) do
			if root then
				for _, child in ipairs(root:GetChildren()) do
					if child.Name:lower():match("^thunderspear_supplies") and not carried then
						local part = colliderOf(child)
						if part and part:IsA("BasePart") then
							local d = (origin - part.Position).Magnitude
							if d < bestDist then best, bestInst, bestDist = part, child, d end
						end
					end
				end
			end
		end
		return bestInst, best
	end

	while not self.cancelled do
		task.wait(0.1)
		if self.cancelled or not H.isInGame() then H.Move.cancel() return end
		local _, root = H.Char.get()
		if not root then continue end

		local tower = H.Thunder.towerTarget()
		local escort, cart = H.Thunder.escortCart()
		local nearby = nearestSupply(root.Position)

		if tower then
			H.Runtime.objectiveMode = true
			local part = tower.part
			if part and part.Parent then
				local size = select(2, pcall(function() return part.Size.Z * 0.5 end)) or 100
				local height = math.max(8, size * 0.92)
				local point = H.Combat.chaseHold(part.Position + Vector3.new(0, height, 0), size, height)
				if (root.Position - point).Magnitude > 12 then H.Move.to(root, point) else H.Move.hold(root) end
			end
			H.UI.thunderStatus("Tower " .. tostring(tower.n))
		elseif escort and cart then
			H.Runtime.objectiveMode = true
			H.Move.to(root, cart.Position + Vector3.new(0, H.Config.HoverHeight, 0))
			H.UI.thunderStatus("Escorting")
		elseif carried or nearby then
			H.Runtime.objectiveMode = true
			if phase == "PICKUP" then
				local part = nearby and nearby[2]
				if part and part.Parent then
					H.Move.to(root, part.Position)
					local size = select(2, pcall(function()
						local s = part.Size
						return math.max(s.X, s.Y, s.Z) * 0.5 + 4
					end)) or 8
					if (root.Position - part.Position).Magnitude <= size then
						if not holdStamp then root.CFrame = CFrame.new(part.Position) holdStamp = os.clock() end
						H.Move.hold(root)
						if os.clock() - holdStamp >= 1.5 then
							carried, carriedPart, phase = nearby[1], part, "DROPOFF"
							holdStamp, attemptStamp = nil, nil
						end
					end
					if not attemptStamp then attemptStamp = os.clock() end
					if os.clock() - attemptStamp > 8 then carried, carriedPart, attemptStamp = nil, nil, nil end
				else H.Move.cancel() end
			else
				local cratePart = select(2, H.Thunder.supplyCrate())
				if cratePart and cratePart.Parent then
					H.Move.to(root, cratePart.Position)
					local size = select(2, pcall(function()
						local s = cratePart.Size
						return math.max(s.X, s.Y, s.Z) * 0.5 + 4
					end)) or 8
					if (root.Position - cratePart.Position).Magnitude <= size then
						if not holdStamp then root.CFrame = CFrame.new(cratePart.Position) holdStamp = os.clock() end
						H.Move.hold(root)
					end
				else H.Move.cancel() end
				if carriedPart and not carriedPart.Parent then
					carried, carriedPart, phase = nil, nil, "PICKUP"
					holdStamp, attemptStamp = nil, nil
				elseif not attemptStamp then attemptStamp = os.clock()
				elseif os.clock() - attemptStamp > 6 then
					if cratePart then root.CFrame = CFrame.new(cratePart.Position) end
					attemptStamp = os.clock()
				end
			end
			H.UI.thunderStatus(phase == "PICKUP" and "Picking up" or "Delivering")
		elseif H.Thunder.supplyCrate() then
			local part = select(2, H.Thunder.supplyCrate())
			H.Runtime.objectiveMode = true
			local point = part.Position + Vector3.new(0, H.Config.HoverHeight, 0)
			local hold = H.Combat.chaseHold(point, 700, H.Config.HoverHeight)
			if (root.Position - hold).Magnitude > 12 then H.Move.to(root, hold) else H.Move.hold(root) end
			H.UI.thunderStatus("Defending supplies")
		elseif H.Runtime.objectiveMode then
			H.Runtime.objectiveMode = false
			H.UI.thunderStatus("Objective done — slaying")
			H.Move.cancel()
			root.Anchored = false
		end
	end
end, function() H.Move.cancel() end)

H.task("ColossalRaid", function(self)
	local cannon, lastShot = nil, 0
	while not self.cancelled do
		task.wait(0.1)
		if self.cancelled or not H.isInGame() or not H.Colossal.active() then
			H.Colossal._firing = false
			H.Colossal.rotationLock(false)
			H.Move.cancel()
			return
		end
		local _, root = H.Char.get()
		if not root then continue end
		if H.Colossal.phase() == 2 then
			local wait = os.clock() + 12
			while H.Colossal._firing and os.clock() < wait and not self.cancelled do task.wait(0.1) end
			H.Colossal._firing = false
			H.Colossal.rotationLock(false)
			H.Move.cancel()
			H.Runtime.objectiveMode = false
			continue
		end
		local stall = RS:FindFirstChild("Objectives")
		stall = stall and stall:FindFirstChild("Stall_Colossal_Titan")
		if stall and (tonumber(stall.Value) or 0) >= (tonumber(stall:GetAttribute("Requirement")) or 0) then
			H.Runtime.objectiveMode = false
			H.Move.cancel()
			continue
		end
		H.Runtime.objectiveMode = true
		if not (cannon and cannon.Parent) then
			cannon = nil
			local best = H.Colossal.cannons()[1]
			if not best then continue end
			cannon = best.inst
			lastShot = 0
		end
		local base = cannon:FindFirstChild("Base")
		if not base then cannon = nil continue end
		local elapsed = os.clock() - lastShot
		local mounted = root:FindFirstChild("Cannon") ~= nil
		local ready = H.Colossal.SHOOT_CD <= elapsed
		if not ready and not (H.Colossal._firing or mounted) and H.Colossal.SHOOT_CD - elapsed > 1.5 then
			local eren = H.Colossal.erenPos()
			local nape = H.Target.smallTitanNape(eren or base.Position)
			if nape and eren and (eren - nape.Position).Magnitude <= H.Colossal.EREN_RADIUS then
				H.Colossal.rotationLock(false)
				H.Move.to(root, nape.Position + Vector3.new(0, H.Config.HoverHeight, 0))
				continue
			end
		end
		if (root.Position - base.Position).Magnitude > 14 then
			H.Colossal.rotationLock(false)
			H.Move.to(root, base.Position + Vector3.new(0, 6, 0))
		else
			H.Move.cancel()
			H.Colossal.rotationLock(true)
			if ready and not H.Colossal._firing then
				H.Colossal.fireCycle(cannon)
				lastShot = os.clock()
			end
		end
	end
end, function()
	H.Colossal._firing = false
	H.Colossal.rotationLock(false)
	H.Move.cancel()
end)

H.task("AutoCreate", function(self)
	local failures = 0
	local function handleFailure(questMode)
		failures = failures + 1
		if failures < 2 then return end
		if not questMode then
			local lower = H.Session.lowerDifficulty(H.Session.asString(H.Lobby.missionDifficulty))
			if lower then
				H.Lobby.missionDifficulty = lower
				H.UI.selectDropdown(H.UI.dropdowns.difficulty, lower)
				failures = 0
			end
		end
		task.wait(math.clamp(failures * 2 - 1, 1, 6))
	end

	while not self.cancelled do
		if H.isInGame() then H.UI.missionStatus("Idle.") return end
		while H.anyBusy() and not H.isInGame() and not self.cancelled do
			H.UI.missionStatus("Waiting: " .. H.busy())
			task.wait(1)
		end
		if self.cancelled or H.isInGame() then return end
		if H.Lobby.boosted then
			local boosted = workspace:GetAttribute("Boosted_Map")
			local known = false
			for _, entry in ipairs(H.MAPS) do
				if entry.name == boosted then known = true break end
			end
			if not (boosted and known) then
				H.UI.missionStatus("Waiting for boosted map...")
				task.wait(5)
				continue
			end
			local savedMap, savedObj = H.Lobby.missionMap, H.Lobby.missionObjective
			H.Lobby.missionMap = boosted
			local objectives = H.Session.objectivesFor(boosted)
			H.Lobby.missionObjective = objectives[2] or objectives[1] or "Skirmish"
			H.UI.missionStatus("Boosted: " .. boosted)
			local ok = H.Session.createMission()
			H.Lobby.missionMap, H.Lobby.missionObjective = savedMap, savedObj
			H.UI.selectDropdown(H.UI.dropdowns.map, savedMap)
			if ok then H.UI.missionStatus("Idle.") return end
			handleFailure(not H.Lobby.questOverride or H.Lobby.thunderMode)
		else
			if H.Session.createMission() then H.UI.missionStatus("Idle.") return end
			handleFailure(not H.Lobby.questOverride or H.Lobby.thunderMode)
		end
	end
end)

