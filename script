function H.DB.save()
	if not writefile_ or H.Lobby.restoring or not H.DB.loaded then return end
	pcall(function()
		if isfolder_ and makefolder_ and not isfolder_(H.DB.FOLDER) then makefolder_(H.DB.FOLDER) end
		writefile_(H.DB.FILE, Http:JSONEncode(H.DB.payload()))
	end)
end

function H.DB.load()
	if not (isfile_ and readfile_) then H.DB.loaded = true return end
	pcall(function()
		if not isfile_(H.DB.FILE) then return end
		local data = Http:JSONDecode(readfile_(H.DB.FILE))
		if type(data) ~= "table" then return end
		if type(data.autoLobbyCounter) == "number" then H.Runtime.autoLobbyCount = data.autoLobbyCounter end
		if type(data.questCache) == "table" then H.Lobby.questCache = data.questCache end
		if type(data.stats) == "table" then
			for k, v in pairs(data.stats) do
				if H.Stats[k] ~= nil then H.Stats[k] = tonumber(v) or 0 end
			end
		end
	end)
	H.DB.loaded = true
end

