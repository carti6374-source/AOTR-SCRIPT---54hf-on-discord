H.ConfigManager = { FOLDER = "MahmutHub_AOTR/config", selected = "" }

function H.ConfigManager.path(name)
	return H.ConfigManager.FOLDER .. "/" .. REAL_NAME .. "_" .. tostring(name) .. ".json"
end

function H.ConfigManager.ensureFolder()
	if not (isfolder_ and makefolder_) then return end
	if not isfolder_(H.ConfigManager.FOLDER) then pcall(makefolder_, H.ConfigManager.FOLDER) end
end

function H.ConfigManager.list()
	if not (readfile_ and isfolder_) then return {} end
	H.ConfigManager.ensureFolder()
	local prefix = REAL_NAME .. "_"
	local out = {}
	for _, full in ipairs(listfiles and listfiles(H.ConfigManager.FOLDER) or {}) do
		local file = full:match("([^/\\]+)%.json$")
		if file and file:sub(1, #prefix) == prefix then
			local ok, body = pcall(readfile_, full)
			if ok and type(body) == "string" and #body > 2 then out[#out + 1] = file:sub(#prefix + 1) end
		end
	end
	table.sort(out)
	return out
end

function H.ConfigManager.collect()
	local flags = {}
	local win = H.UI.Window
	if win and win.Flags then
		for key, flag in pairs(win.Flags) do
			local ok, value = pcall(function() return flag.Value end)
			if ok and value ~= nil then flags[key] = value end
		end
	end
	return flags
end

function H.ConfigManager.save(name)
	name = H.trim(name)
	if name == "" then return false, "Name required" end
	if not writefile_ then return false, "No writefile" end
	H.ConfigManager.ensureFolder()
	local ok = pcall(writefile_, H.ConfigManager.path(name), Http:JSONEncode(H.ConfigManager.collect()))
	return ok, ok and nil or "Write failed"
end

function H.ConfigManager.load(name)
	if not (readfile_ and isfile_) then return false, "No readfile" end
	local path = H.ConfigManager.path(name)
	if not isfile_(path) then return false, "Preset not found" end
	local ok, err = pcall(function()
		local data = Http:JSONDecode(readfile_(path))
		if type(data) ~= "table" or not next(data) then error("Empty preset") end
		local win = H.UI.Window
		if not (win and win.Flags) then return end
		H.Lobby.restoring = true
		local priority = { "Map", "Difficulty", "Objective" }
		local function apply(key, value)
			local flag = win.Flags[key]
			if not flag then return end
			pcall(function()
				if type(flag.Set) == "function" then flag:Set(value)
				elseif type(flag.Select) == "function" then flag:Select(value) end
			end)
		end
		for _, key in ipairs(priority) do
			if data[key] ~= nil then apply(key, data[key]) end
		end
		for key, value in pairs(data) do
			if not table.find(priority, key) then apply(key, value) end
		end
		H.Lobby.restoring = false
	end)
	if not ok then H.Lobby.restoring = false end
	return ok, err
end

function H.ConfigManager.delete(name)
	if not writefile_ then return false end
	local path = H.ConfigManager.path(name)
	if delfile_ then pcall(delfile_, path) else pcall(writefile_, path, "{}") end
	return true
end

function H.ConfigManager.export()
	return "MHC1:" .. H.b64enc(Http:JSONEncode({ version = H.VERSION, flags = H.ConfigManager.collect() }))
end

function H.ConfigManager.import(code)
	code = H.trim(code)
	if code:sub(1, 5) ~= "MHC1:" then return false, "Not a config code" end
	local ok, data = pcall(function() return Http:JSONDecode(H.b64dec(code:sub(6))) end)
	if not ok or type(data) ~= "table" or type(data.flags) ~= "table" then return false, "Corrupt code" end
	local win = H.UI.Window
	H.Lobby.restoring = true
	for key, value in pairs(data.flags) do
		local flag = win and win.Flags and win.Flags[key]
		if flag then pcall(function() flag:Set(value) end) end
	end
	H.Lobby.restoring = false
	return true
end

