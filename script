H.RewardHook = { QUEUE = "__MH_REWARD_Q", _installed = false, _get = nil, _chest = nil }

H.RewardHook.SRC = [[
local QUEUE_NAME = ...
if _G.__MH_REWARD_HOOK then return end
_G.__MH_REWARD_HOOK = true
local RS = game:GetService("ReplicatedStorage")
local remotes = RS:FindFirstChild("Assets") and RS.Assets:FindFirstChild("Remotes")
local GET = remotes and remotes:FindFirstChild("GET")
if not GET then return end
if not (getrawmetatable and setreadonly and newcclosure and getnamecallmethod) then return end
local HS = game:GetService("HttpService")
local function q()
    local v = workspace:FindFirstChild(QUEUE_NAME)
    if not v then v = Instance.new("StringValue") v.Name = QUEUE_NAME v.Value = "" v.Parent = workspace end
    return v
end
local function extract(kind, a)
    if type(a) ~= "table" then return nil end
    local o = { obtained = {}, perks = {}, drops = {}, stats = {} }
    if kind == "Chest" then
        for _, item in ipairs(a) do
            if type(item) == "table" then
                local nm = item.Real_Tag or item.Tag or item.Name
                if nm ~= nil then o.drops[#o.drops + 1] = tostring(nm) end
            end
        end
        return o
    end
    local ob = a.Obtained
    if type(ob) == "table" then
        for k, v in pairs(ob) do
            if type(v) == "number" then o.obtained[tostring(k)] = v
            elseif k == "Perks" and type(v) == "table" then
                for _, pn in pairs(v) do o.perks[#o.perks + 1] = tostring(pn) end
            elseif k == "Drops" and type(v) == "table" then
                for _, dn in pairs(v) do o.drops[#o.drops + 1] = tostring(dn) end
            end
        end
    end
    local st = a.Stats
    if type(st) == "table" then
        for _, key in ipairs({ "Time_Taken", "Damage", "Kills", "Crits", "Waves" }) do
            local n = st[key]
            if type(n) == "number" then o.stats[key] = n end
        end
    end
    if a.Completed ~= nil then o.completed = a.Completed and true or false end
    return o
end
local function push(kind, a)
    local ok, small = pcall(extract, kind, a)
    if not ok or not small then return end
    small.kind = kind
    local ok2, json = pcall(function() return HS:JSONEncode(small) end)
    if not ok2 then return end
    local v = q()
    local cur = v.Value
    if #cur > 100000 then cur = "" end
    v.Value = cur .. json .. "\n"
end
local mt = getrawmetatable(game)
local old = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    if self == GET then
        local ok, m = pcall(getnamecallmethod)
        if ok and m == "InvokeServer" then
            local a2 = select(2, ...)
            if (...) == "S_Rewards" and (a2 == "Get" or a2 == "Chest") then
                local a, b = old(self, ...)
                pcall(push, a2, a)
                return a, b
            end
        end
    end
    return old(self, ...)
end)
setreadonly(mt, true)
]]

function H.RewardHook.reset()
	H.RewardHook._get = nil
	H.RewardHook._chest = nil
	local q = workspace:FindFirstChild(H.RewardHook.QUEUE)
	if q then q.Value = "" end
end

function H.RewardHook.drain()
	local q = workspace:FindFirstChild(H.RewardHook.QUEUE)
	if not q or q.Value == "" then return end
	local raw = q.Value
	q.Value = ""
	for line in string.gmatch(raw, "([^\n]+)") do
		local ok, data = pcall(function() return Http:JSONDecode(line) end)
		if ok and type(data) == "table" then
			if data.kind == "Chest" then
				local chest = H.RewardHook._chest or { obtained = {}, perks = {}, drops = {} }
				for k, v in pairs(data.obtained or {}) do chest.obtained[k] = (chest.obtained[k] or 0) + (tonumber(v) or 0) end
				for _, v in ipairs(data.perks or {}) do chest.perks[#chest.perks + 1] = v end
				for _, v in ipairs(data.drops or {}) do chest.drops[#chest.drops + 1] = v end
				H.RewardHook._chest = chest
			else
				H.RewardHook._get = data
			end
		end
	end
end

function H.RewardHook.start()
	if H.RewardHook._installed or not (run_on_actor_ and getactors_) then return end
	local seen = setmetatable({}, { __mode = "k" })

	local function relevant(actor)
		local ok, parent = pcall(function() return actor.Parent end)
		if not ok or not parent then return false end
		if parent.Name == REAL_NAME or parent.Name == "Characters" or parent.Name == "Shifters" or parent.Name == "Titans" then return true end
		if LP.Character then
			local ok2, inside = pcall(function() return parent:IsDescendantOf(LP.Character) end)
			if ok2 and inside then return true end
		end
		return false
	end

	local okActors, actors = pcall(getactors_)
	if okActors and actors then
		for _, actor in pairs(actors) do
			if relevant(actor) and pcall(run_on_actor_, actor, H.RewardHook.SRC, H.RewardHook.QUEUE) then seen[actor] = true break end
		end
	end

	H.connect("RewardHookPoll", task.spawn(function()
		while true do
			local ok, list = pcall(getactors_)
			if ok and list then
				for _, actor in pairs(list) do
					if not seen[actor] and relevant(actor) then
						if pcall(run_on_actor_, actor, H.RewardHook.SRC, H.RewardHook.QUEUE) then seen[actor] = true end
					end
				end
			end
			task.wait(0.5)
		end
	end))

	H.connect("RewardHookDrain", task.spawn(function()
		while true do
			pcall(H.RewardHook.drain)
			task.wait(0.25)
		end
	end))

	H.RewardHook._installed = true
end

function H.RewardHook.stop()
	H.disconnect("RewardHookPoll")
	H.disconnect("RewardHookDrain")
	H.RewardHook._installed = false
end

