function H.Skill.plan()
	local auto = H.Lobby.autoSkill
	local weapon = H.Stats.weapon or "Blades"
	local paths = H.Skill.PATHS[weapon] or H.Skill.PATHS.Blades
	local order
	if auto.strategy == "Focus Defense First" then order = { auto.defense, auto.offense, auto.support }
	elseif auto.strategy == "Focus Support First" then order = { auto.support, auto.offense, auto.defense }
	else order = { auto.offense, auto.defense, auto.support } end

	local perks = {}
	for _, label in ipairs(auto.perkOrder or {}) do
		local path = H.Skill.SLOT_PATHS[label:lower()]
