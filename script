H.task("ThunderQuest", function(self)
	if H.isInGame() then return end
	H.Lobby.thunderMode = true
	H.UI.thunderStatus("Reading quest progress...")
	local attempts, limit = 0, 4
	local progress = H.Thunder.openPanel()
	if not next(progress) then progress = H.Lobby.questCache or {} end
	while not self.cancelled and not H.isInGame() do
		progress = H.Thunder.openPanel()
		if not next(progress) then progress = H.Lobby.questCache or {} end
		local quest = H.Thunder.nextQuest(progress)
		if not quest then
			H.Lobby.thunderMode = false
			H.UI.thunderStatus("All quests complete.")
			break
		end
		H.UI.thunderStatus(string.format("%s — %s", quest.name, H.Thunder.progressString(quest, progress)))
		if H.Thunder.runQuest(quest) then
			H.Lobby.thunderRan[quest.name] = true
			attempts = 0
			local wait = os.clock() + 15
			while not H.isInGame() and os.clock() < wait and not self.cancelled do task.wait(1) end
			if H.isInGame() then
				H.Thunder.beginFarming()
				break
			end
		else
			attempts = attempts + 1
			if attempts >= limit then
				H.Lobby.thunderMode = false
				H.UI.thunderStatus("Gave up on " .. quest.name)
				break
			end
			task.wait(5)
		end
	end
end, function()
