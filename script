function H.UI.screenGui()
	local gui = gethui():FindFirstChild("MahmutHub")
	if gui then return gui end
	local playerGui = LP:FindFirstChild("PlayerGui")
	return playerGui and playerGui:FindFirstChild("MahmutHub")
end

function H.UI.setScale(pct)
	local gui = H.UI.screenGui()
	if not gui then return end
	local scale = gui:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Parent = gui
	end
	scale.Scale = H.clamp(pct, 50, 160) / 100
end

function H.UI.traverse(fn)
	local gui = H.UI.screenGui()
	if not gui then return end
	for _, d in ipairs(gui:GetDescendants()) do pcall(fn, d) end
end

function H.UI.applyCorners(radius)
	H.UI.traverse(function(d)
		local corner = d:FindFirstChildOfClass("UICorner")
		if corner then corner.CornerRadius = UDim.new(0, radius) end
	end)
end

function H.UI.applyStroke(thickness)
	H.UI.traverse(function(d)
		local stroke = d:FindFirstChildOfClass("UIStroke")
		if stroke then stroke.Thickness = thickness end
	end)
end

function H.UI.applyFontSize(size)
	H.UI.traverse(function(d)
		if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
			if d.TextSize > 8 then d.TextSize = size end
		end
	end)
end

function H.UI.applyAlpha(windowAlpha, elementAlpha)
	H.UI.traverse(function(d)
		if d:IsA("Frame") or d:IsA("ScrollingFrame") or d:IsA("TextLabel") or d:IsA("TextButton") then
			if d:IsA("Frame") then d.BackgroundTransparency = 1 - windowAlpha / 100 end
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				if d.BackgroundTransparency < 1 then d.BackgroundTransparency = 1 - elementAlpha / 100 end
			end
		end
	end)
end

