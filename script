	if H.LOBBY_PLACES[game.PlaceId] then
		H.DataCopy.fetch()
		if LP:GetAttribute("Blacklisted") == true or LP:GetAttribute("Exploiter") == true or H.Stats.shadowBan == true then
			return "SHADOW_BANNED", H.Stats.disabledReason or "Disabled"
		end
		return "SAFE"
	end
	if (H.Stats.dataCopyStamp or 0) > 0 then
		return H.Stats.shadowBan and "SHADOW_BANNED" or "SAFE", H.Stats.disabledReason
	end
	return "UNKNOWN"
end

---------------------------------------------------------------------
-- 7. hook manager (chain-safe)
---------------------------------------------------------------------

H.Hook = { active = {}, meta = nil }

function H.Hook.available()
	return getrawmetatable ~= nil and setreadonly ~= nil and newcclosure ~= nil and getnamecallmethod ~= nil
end

function H.Hook.metatable()
	if H.Hook.meta then return H.Hook.meta end
	if not H.Hook.available() then return nil end
	local ok, mt = pcall(getrawmetatable, game)
	if not ok or not mt then return nil end
	H.Hook.meta = mt
	return mt
end

-- install(name, key, handler): handler(self, ...) must call H.Hook.call(name, ...) to continue
function H.Hook.install(name, key, handler)
	local mt = H.Hook.metatable()
	if not mt then return false end
	if H.Hook.active[name] then return true end

	local original = mt[key]
	H.Hook.active[name] = { key = key, original = original }

	pcall(setreadonly, mt, false)
	mt[key] = newcclosure(function(self, ...)
		local entry = H.Hook.active[name]
		if not entry then return original(self, ...) end
		return handler(self, ...)
	end)
	pcall(setreadonly, mt, true)
	return true
end

function H.Hook.call(name, self, ...)
	local entry = H.Hook.active[name]
	if not entry then return end
	return entry.original(self, ...)
end

function H.Hook.restore(name)
	local entry = H.Hook.active[name]
	local mt = H.Hook.meta
	if not entry or not mt then return end
	H.Hook.active[name] = nil
	pcall(setreadonly, mt, false)
	mt[entry.key] = entry.original
	pcall(setreadonly, mt, true)
end

function H.Hook.restoreAll()
	for name in pairs(H.Hook.active) do H.Hook.restore(name) end
end

