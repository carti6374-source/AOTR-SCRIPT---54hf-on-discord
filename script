H.Combat = {}

function H.Combat.hasAutoReload()
	return type(H.Stats.unlockedSkills) == "table" and H.Stats.unlockedSkills[H.SKILL.AUTO_RELOAD] == true
end

function H.Combat.timeDiff() return math.random(100, 800) / 1000 end
function H.Combat.bv() return math.random(200, 400) end

function H.Combat.register(nape)
	H.Net.fire(H.REMOTE.POST, "Hitboxes", "Register", nape, H.Combat.bv(), H.Combat.timeDiff())
end

function H.Combat.swing() H.Net.post("Attacks", "Slash", { timeout = 4 }) end

function H.Combat.hasTarget(range)
	local _, root = H.Char.get()
	if not root then return nil end
	range = range or 500
	local pos = root.Position
	local nape = H.Runtime.nape
	if nape and nape.Parent and (pos - nape.Position).Magnitude <= range then return nape end
	local titans = workspace:FindFirstChild("Titans")
	if not titans then return nil end
	local best, bestDist = nil, range
	for _, titan in ipairs(titans:GetChildren()) do
		if titan:IsA("Model") and titan:FindFirstChildOfClass("Humanoid") and H.Target.attackable(titan) then
			local n = H.Target.napeOf(titan)
			if n then
				local d = (pos - n.Position).Magnitude
				if d <= bestDist then best, bestDist = n, d end
			end
		end
	end
	return best
end

function H.Combat.napeNear(origin, range)
	local titans = workspace:FindFirstChild("Titans")
	if not titans then return nil end
	local best, bestDist = nil, range
	for _, titan in ipairs(titans:GetChildren()) do
		if titan:IsA("Model") and titan:FindFirstChildOfClass("Humanoid") and H.Target.attackable(titan) then
			local n = H.Target.napeOf(titan)
			if n then
				local d = (origin - n.Position).Magnitude
				if d <= bestDist then best, bestDist = n, d end
			end
		end
	end
	return best
end

function H.Combat.chaseHold(origin, range, height)
	local nape = H.Combat.napeNear(origin, range or 1000)
	if nape and nape.Parent then return nape.Position + Vector3.new(0, height or H.Config.HoverHeight, 0) end
	return origin
end

function H.Combat.multiRadius() return H.num(H.Config.MultiHitRadius, 250) end

function H.Combat.pickBossHitbox(folder, index)
	local parts = {}
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BasePart") and child.Name ~= "Nape" then parts[#parts + 1] = child end
	end
	if #parts == 0 then return folder:FindFirstChild("Nape") end
	if index < 5 then return parts[index % #parts + 1] end
	local rem = index % 10
	if rem < 5 then return parts[rem % #parts + 1] end
	return folder:FindFirstChild("Nape")
end

local function gatherMulti(originNape, rootPos, exclude, limit)
	local titans = workspace:FindFirstChild("Titans")
	if not titans then return {} end
	local out = {}
	for _, titan in ipairs(titans:GetChildren()) do
		if titan ~= exclude and titan:IsA("Model") and titan:FindFirstChildOfClass("Humanoid") and H.Target.attackable(titan) then
			local nape = H.Target.napeOf(titan)
			if nape and H.Target.valid(titan, nape)
				and (nape.Position - originNape.Position).Magnitude <= H.Combat.multiRadius() then
				out[#out + 1] = { nape = nape, dist = (rootPos - nape.Position).Magnitude }
			end
		end
	end
	table.sort(out, function(a, b) return a.dist < b.dist end)
	local trimmed = {}
	for i = 1, math.min(#out, limit) do trimmed[i] = out[i] end
	return trimmed
end

function H.Combat.attack()
	local nape = H.Runtime.nape
	if not nape then return end
	local _, root = H.Char.get()
	if not root then return end
	local titan = H.safeIndex(nape, "Parent", "Parent", "Parent")
	if not H.Target.attackable(titan) then return end

	local bossHover = H.Runtime.bossHover and workspace:GetAttribute("Objective") == "Colossal Titan"
	local reach
	if bossHover then reach = math.huge
	elseif H.Runtime.objectiveMode or H.Runtime.bossHover then reach = 1000
	else reach = H.Config.HoverHeight + 50 end
	if reach < (root.Position - nape.Position).Magnitude then return end

	local now = os.clock()
	if now - H.Runtime.attackBlockedTick < H.T.BLOCK_AFTER_RELOAD then return end

	if H.Runtime.attackCombo >= H.T.COMBO_MAX then
		if now - H.Runtime.lastComboTick < H.T.COMBO_RESET then return end
		H.Runtime.attackCombo = 0
	end
	if now - H.Runtime.lastAttackTick < H.Anti.gap(H.T.ATTACK_GAP) then return end

	local name = titan.Name
	local isBoss = not (workspace:GetAttribute("Objective") == "Stall" or name == "" or name:match("^%x+%-%x+%-%x+%-%x+%-%x+$"))
	if isBoss and now - H.Runtime.lastBossBladeTick < H.Anti.gap(H.T.BOSS_BLADE_GAP) then return end

	local prevA, prevC, prevT = H.Runtime.lastAttackTick, H.Runtime.attackCombo, H.Runtime.lastComboTick
	H.Runtime.lastAttackTick = now
	if isBoss then H.Runtime.lastBossBladeTick = now end
	H.Runtime.attackCombo = H.Runtime.attackCombo + 1
	H.Runtime.lastComboTick = now

	local shifting = LP:GetAttribute("Shifting") == true
	local stall = workspace:GetAttribute("Objective") == "Stall"

	if not shifting and LP:GetAttribute("Weapon") == "Spears" then
		if now - H.Runtime.lastSpearTick < H.Runtime.spearGap then
			H.Runtime.lastAttackTick, H.Runtime.attackCombo, H.Runtime.lastComboTick = prevA, prevC, prevT
			return
		end
		H.Runtime.lastSpearTick = now
		H.Runtime.spearGap = H.Anti.gap(0.9)

		local label = H.gui(H.PATH.SPEARS)
		local count = label and tonumber(tostring(label.Text):match("^%s*(%d+)")) or 0
		if count <= 0 and not H.Config.InfiniteSpear then return end

		local points = { nape.Position }
		local bossLike = not stall and titan.Name:match("^%x+%-%x+%-%x+%-%x+%-%x+$") == nil
		local burst = H.Config.GhostMode and math.max(1, math.floor(H.clamp(H.Config.BossBurst, 1, 10) * 0.7)) or H.clamp(H.Config.BossBurst, 1, 10)

		if bossLike then
			local folder = H.safeIndex(titan, "Hitboxes", "Hit")
			local part = folder and H.Combat.pickBossHitbox(folder, H.Runtime.bossHitboxRotIdx) or nape
			local origin = part and part.Position or nape.Position
			points = { origin }
			for _ = 1, burst do
				points[#points + 1] = origin + Vector3.new(math.random(-5, 5), math.random(-2, 2), math.random(-5, 5))
			end
			H.Runtime.bossHitboxRotIdx = H.Runtime.bossHitboxRotIdx + 1
		elseif not stall and H.Config.MultiHitEnabled then
			local extra = math.max(1, H.num(H.Config.MultiHit, 1))
			if H.Config.GhostMode then extra = math.max(1, math.ceil(extra * 0.6)) end
			for _, hit in ipairs(gatherMulti(nape, root.Position, titan, extra - 1)) do points[#points + 1] = hit.nape.Position end
		end

		local payload = {}
		for i, p in ipairs(points) do payload[i] = string.format("%s,%s,%s", p.X, p.Y, p.Z) end
		local encoded = table.concat(payload, H.SEP)

		H.Net.get("Spears", "S_Fire", { args = { tostring(#points) }, timeout = 5 })
		for chunk in string.gmatch(encoded, "([^" .. H.SEP .. "]+)") do
			local x, y, z = chunk:match("([^,]+),([^,]+),([^,]+)")
			if x then
				H.Net.fire(H.REMOTE.POST, "Spears", "S_Explode", Vector3.new(tonumber(x), tonumber(y), tonumber(z)), H.Combat.timeDiff())
			end
		end
		return
	end

	local bossFolder = H.safeIndex(titan, "Hitboxes", "Hit")
	local bossMode = bossFolder ~= nil and not stall
	local limit = (not stall and H.Config.MultiHitEnabled) and math.max(1, H.num(H.Config.MultiHit, 1)) or 1
	if H.Config.GhostMode and limit > 1 then limit = math.max(1, math.ceil(limit * 0.6)) end

	local list = { nape }
	if limit > 1 then
		for _, hit in ipairs(gatherMulti(nape, root.Position, titan, limit - 1)) do list[#list + 1] = hit.nape end
	end

	H.Combat.swing()
	if bossMode then
		local part = H.Combat.pickBossHitbox(bossFolder, H.Runtime.bossHitboxRotIdx)
		if part then
			local burst = H.Config.GhostMode and math.max(1, math.floor(H.clamp(H.Config.BossBurst, 1, 10) * 0.7)) or H.clamp(H.Config.BossBurst, 1, 10)
			for _ = 1, burst do H.Combat.register(part) end
			H.Runtime.bossHitboxRotIdx = H.Runtime.bossHitboxRotIdx + 1
		end
	else
		for _, n in ipairs(list) do H.Combat.register(n) end
	end
	H.Net.post("Attacks", "Slash", { args = { false }, timeout = 4 })
end

function H.Combat.reload()
	if not H.Config.AutoReload or H.Runtime.isReloading then return end
	local now = os.clock()
	if now - H.Runtime.fullReloadCooldownTick < H.T.FULL_RELOAD_GAP then return end
	if now - H.Runtime.lastReloadTick < H.Anti.gap(H.T.RELOAD_GAP) then return end
	local blade = H.Char.blade()
	if not blade or blade.Transparency ~= 1 then return end
	local char = LP.Character
	if char and char:GetAttribute("IFrames") ~= nil then return end
	local count = H.Cache.setsLabel and tonumber(tostring(H.Cache.setsLabel.Text):match("^(%d+)"))
	if not count or count <= 0 then return end

	H.Runtime.isReloading = true
	H.Runtime.lastReloadTick = now
	H.Runtime.attackBlockedTick = now
	pcall(function()
		H.Net.actor("Blades", "Reload", { args = { "Reload" }, timeout = 5 })
		local deadline = os.clock() + 4
		while os.clock() < deadline do
			task.wait(0.1)
			local b = H.Char.blade()
			if b and b.Transparency ~= 1 then return end
		end
	end)
	H.Runtime.attackBlockedTick = 0
	H.Runtime.isReloading = false
end

function H.Combat.findRefill() return workspace:FindFirstChild("Refill", true) end

function H.Combat.useRefill()
	local now = os.clock()
	local refill = H.Cache.refill
	if not refill or not refill.Parent or now - H.Runtime.lastRefillSearchTick > H.T.REFILL_SEARCH_GAP then
		H.Cache.refill = H.Combat.findRefill()
		H.Runtime.lastRefillSearchTick = now
	end
	refill = H.Cache.refill
	if not refill then return false end
	H.Runtime.lastFullReloadTick = now
	H.Runtime.fullReloadCooldownTick = now
	H.Runtime.attackBlockedTick = now
	H.Net.fire(H.REMOTE.POST, "Attacks", "Reload", refill)
	return true
end

function H.Combat.fullReload()
	if not H.Config.AutoFullReload then return end
	if not H.Cache.setsLabel then
		if H.Runtime.bladeInitRunning then return end
		H.Runtime.bladeInitRunning = true
		H.Char.initBladeRefs()
		H.Runtime.bladeInitRunning = false
		if not H.Cache.setsLabel then return end
	end
	if H.Cache.setsLabel.Text ~= "0 / 3" then return end
	if not H.Char.allSetsUsed() then return end
	local blade = H.Char.blade()
	if not blade or blade.Transparency ~= 1 then return end
	H.Combat.useRefill()
end

function H.Combat.fireSkill(slot, target, isTable)
	local payload = target
	if target and isTable then payload = { target } end
	H.Net.actor("S_Skills", "Usage", { args = { slot, nil, payload }, timeout = 4 })
end

