H.Session = {}

local CREATE_MAP = [[
if typeof(res) == "Instance" and res.Name then out = { ok = true, name = res.Name }
else out = { ok = false, retType = typeof(res), retVal = tostring(res) } end
]]

function H.Session.asString(v)
	if type(v) == "string" then return v end
	if type(v) ~= "table" then return tostring(v or "") end
	for k, flag in pairs(v) do if flag == true and type(k) == "string" then return k end end
	return tostring(v[1] or "")
end

function H.Session.objectivesFor(map)
	for _, entry in ipairs(H.MAPS) do
		if entry.name == map then return entry.objectives end
	end
	return { "Skirmish" }
end

function H.Session.lowerDifficulty(current)
	for i, v in ipairs(H.DIFFICULTIES) do
		if v == current then return i > 1 and H.DIFFICULTIES[i - 1] or nil end
	end
	return nil
end

function H.Session.toggleModifier(name)
	H.Net.actor("S_Missions", "Modify", { args = { name }, map = "out = true", timeout = 5 })
end

function H.Session.leave()
	local res = H.Net.actor("S_Missions", "Leave", { map = "out = (res == true)", timeout = 5 })
	return res ~= nil and res.ok == true and res.data == true
end

function H.Session.create(kind, params)
	local exprParts = {}
	for _, key in ipairs({ "Name", "Difficulty", "Type", "Objective" }) do
		exprParts[#exprParts + 1] = string.format("%s = %q", key, H.Session.asString(params[key:lower()] or params[key]))
	end
	local res = H.Net.actor("S_Missions", "Create", {
		args = { loadstring_("return { " .. table.concat(exprParts, ", ") .. ", Minimum = nil }")() },
		map = CREATE_MAP, timeout = 10,
	})
	if not res or not res.ok or type(res.data) ~= "table" or not res.data.ok then
		H.log(kind .. ".create rejected: " .. tostring(res and (res.err or res.data and res.data.retVal) or "nil"))
		return nil
	end
	return { ok = true, name = res.data.name }
end

function H.Session.start()
	local res = H.Net.actor("S_Missions", "Start", { timeout = 8 })
	return res ~= nil and res.ok == true
end

function H.Session.createAndStart(label, report, kind, params, modifiers)
	report("Creating session...")
	local created = H.Session.create(kind, params)
	if not created then
		report("Create failed, clearing...")
		H.Session.leave()
		task.wait(0.5)
		return false
	end
	for _, mod in ipairs(modifiers or {}) do
		H.Session.toggleModifier(mod)
		task.wait(0.3)
	end
	report("Starting...")
	task.wait(0.5)
	if not H.Session.start() then
		report("Start failed, destroying...")
		H.notify(label, "Failed to start, destroying", 3, "skull")
		H.Session.leave()
		task.wait(0.5)
		return false
	end
	report("Started! " .. (created.name or params.map))
	return true
end

function H.Session.createMission()
	return H.Session.createAndStart("Mission", H.UI.missionStatus, "Missions", {
		map = H.Session.asString(H.Lobby.missionMap),
		objective = H.Session.asString(H.Lobby.missionObjective),
		difficulty = H.Session.asString(H.Lobby.missionDifficulty),
	}, H.Lobby.missionModifiers)
