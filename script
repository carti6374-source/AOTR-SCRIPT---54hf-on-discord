function H.ESP.build()
	H.ESP.clear()
	local titans = workspace:FindFirstChild("Titans")
	if not titans then return end
	local folder = Instance.new("Folder")
	folder.Name = "MahmutESP"
	folder.Parent = workspace
	H.Cache.espFolder = folder

	local function add(titan)
		if H.Cache.espHighlights[titan] or titan:GetAttribute("State") == "Dead" then return end
		local hl = Instance.new("Highlight")
		hl.FillColor = Color3.fromHex("8B5CF6")
		hl.OutlineColor = Color3.fromHex("A855F7")
		hl.FillTransparency = 0.45
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Adornee = titan
		hl.Parent = folder
		H.Cache.espHighlights[titan] = hl
	end

	for _, titan in ipairs(titans:GetChildren()) do add(titan) end
	H.connect("ESPAdd", titans.ChildAdded:Connect(function(t)
		if not H.Config.TitanESP or not H.Cache.espFolder then return end
		task.wait(0.1)
		add(t)
	end))
	H.connect("ESPRemove", titans.ChildRemoved:Connect(function(t)
		local hl = H.Cache.espHighlights[t]
		H.Cache.espHighlights[t] = nil
		if hl then pcall(function() hl:Destroy() end) end
	end))
end

H.Perf = { origDensity = nil, AMBIENT = 0.15, reapplying = false }

function H.Perf.setFog(remove)
	pcall(function()
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if remove then
			if not atm then return end
			local density = atm.Density
			if H.Perf.AMBIENT >= density then return end
			if H.Perf.origDensity == nil then H.Perf.origDensity = density end
			atm.Density = H.Perf.AMBIENT
			if H.Conn.FogMonitor then return end
			H.connect("FogMonitor", atm:GetPropertyChangedSignal("Density"):Connect(function()
				if not H.Config.RemoveFog or H.Perf.reapplying then return end
				H.Perf.reapplying = true
				task.delay(0.5, function()
					H.Perf.reapplying = false
					if H.Config.RemoveFog then H.Perf.setFog(true) end
				end)
			end))
			return
		end
		H.disconnect("FogMonitor")
		if atm and H.Perf.origDensity then atm.Density = H.Perf.origDensity end
		H.Perf.origDensity = nil
	end)
end

function H.Perf.applyAll() if H.isInGame() then H.Perf.setFog(H.Config.RemoveFog) end end

