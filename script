H.DEBUG = false

local function fmt(...)
	local parts = {}
	for i = 1, select("#", ...) do parts[i] = tostring((select(i, ...))) end
	return table.concat(parts, " ")
end

function H.log(...)
	if not H.DEBUG then return end
	print("[MahmutHub] " .. fmt(...))
end

function H.warn(...)
	warn("[MahmutHub] " .. fmt(...))
end

function H.notify(title, content, duration, icon)
	if not (H.UI and H.UI.Window) then return end
	pcall(function()
		H.UI.Window:Notify({ Title = title or "Mahmut Hub", Content = content or "", Duration = duration or 3, Icon = icon or "info" })
	end)
end

H.Report = { url = "", seen = {}, count = 0, windowStart = 0, MAX = 20 }

function H.Report.url()
	if H.UI and H.UI.Window and H.UI.Window.Flags then
		local flag = H.UI.Window.Flags.LogWebhook
		if flag and type(flag.Value) == "string" then H.Report.url = flag.Value:gsub("^%s*(.-)%s*$", "%1") end
	end
	return H.Report.url
end

function H.Report.push(err, ctx)
	local url = H.Report.url()
	if url == "" or not request_ then return end
	local now = os.clock()
	if now - H.Report.windowStart > 60 then H.Report.windowStart = now H.Report.count = 0 end
	if H.Report.count >= H.Report.MAX then return end

	local trace = tostring(err) .. "\n" .. debug.traceback("", 2)
	local hash = tostring(#trace) .. "_" .. trace:sub(1, 60)
	if H.Report.seen[hash] and now - H.Report.seen[hash] < 120 then return end
	H.Report.seen[hash] = now
	H.Report.count = H.Report.count + 1

	pcall(request_, {
		Url = url,
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = Http:JSONEncode({
			content = "@here",
			allowed_mentions = { parse = { "everyone" } },
			embeds = { {
				title = "Error",
				description = "```\n" .. trace:sub(1, 1800) .. "\n```",
				color = 10027263,
				fields = {
					{ name = "Context", value = tostring(ctx or "?"), inline = true },
					{ name = "Version", value = H.VERSION, inline = true },
					{ name = "Place", value = tostring(game.PlaceId), inline = true },
					{ name = "Executor", value = tostring(identify_ and select(1, identify_()) or "?"), inline = true },
				},
			} },
		}),
	})
end

function H.guard(ctx, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		H.warn(ctx, err)
		task.spawn(H.Report.push, err, ctx)
	end
	return ok, err
end

