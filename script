function H.UI.pushUndo(flag, oldValue, newValue)
	if oldValue == newValue then return end
	H.UI.undo[#H.UI.undo + 1] = { flag = flag, old = oldValue, new = newValue, t = os.clock() }
	if #H.UI.undo > 15 then table.remove(H.UI.undo, 1) end
end

function H.UI.undoLast()
	local entry = table.remove(H.UI.undo)
	if not entry then return false end
	local win = H.UI.Window
	local flag = win and win.Flags and win.Flags[entry.flag]
	if not flag then return false end
	pcall(function() flag:Set(entry.old) end)
	return true
end

