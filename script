function H.Perks.deleteByRarity()
	local rarities = H.selection(H.Config.DeletePerksRarities)
	if #rarities == 0 then return 0 end
	local wanted = {}
	for _, r in ipairs(rarities) do wanted[r] = true end
	local ids = {}
	for _, perk in ipairs(H.Stats.perkStorage or {}) do
		if wanted[perk.rarity] then ids[#ids + 1] = perk.id end
	end
	if #ids == 0 then return 0 end
	task.wait(3)
	local deleted = 0
	for i = 1, #ids, 20 do
		local batch = {}
		for j = i, math.min(i + 19, #ids) do batch[#batch + 1] = ids[j] end
		local ok = false
		for _ = 1, 5 do
			if H.Perks.delete(batch) then ok = true break end
			task.wait(2)
		end
		if not ok then break end
		deleted = deleted + #batch
	end
	if deleted > 0 then H.notify("Perks", string.format("Deleted %d", deleted), 4, "trash-2") end
	return deleted
end

