H.Update = { notice = "", killed = {} }

local function semver(v)
	local a, b, c = tostring(v or ""):match("^(%d+)%.(%d+)%.(%d+)")
	return (tonumber(a) or 0) * 10000 + (tonumber(b) or 0) * 100 + (tonumber(c) or 0)
end

function H.Update.check()
	if not request_ then return end
	local ok, res = pcall(request_, { Url = H.REPO .. "manifest.json", Method = "GET" })
	if not ok or type(res) ~= "table" or type(res.Body) ~= "string" then return end
	local okDecode, data = pcall(function() return Http:JSONDecode(res.Body) end)
	if not okDecode or type(data) ~= "table" then return end

	if type(data.killed) == "table" then H.Update.killed = data.killed end
	if type(data.notice) == "string" then H.Update.notice = data.notice end
	if data.latest and semver(data.latest) > semver(H.VERSION) then
		H.Update.notice = (H.Update.notice ~= "" and H.Update.notice .. " — " or "") .. "v" .. tostring(data.latest) .. " available"
	end
end

function H.Update.isKilled(key)
	return H.Update.killed[key] ~= nil
end

function H.Update.killReason(key)
	local reason = H.Update.killed[key]
	return type(reason) == "string" and reason or nil
end

