function H.StatsWebhook.send(title, description, color, fields, opts)
	local url = H.StatsWebhook.url()
	if url == "" or not request_ then return end
	opts = opts or {}
	local embed = { title = title, description = description, color = color or 5793266, fields = fields or {}, footer = { text = "Mahmut Hub " .. H.VERSION } }
	if opts.thumbnail then embed.thumbnail = { url = opts.thumbnail } end
	local payload = { username = "Mahmut Hub", avatar_url = "https://i.imgur.com/KrAE1vB.png", embeds = { embed } }
	if opts.mention then
		payload.content = "@everyone"
		payload.allowed_mentions = { parse = { "everyone" } }
	end
	pcall(request_, { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = Http:JSONEncode(payload) })
end

function H.StatsWebhook.progressFields()
	local snap = H.Prestige.snapshot()
	local fields = { { name = "Player", value = H.userTag(), inline = true } }
	if snap then
		fields[#fields + 1] = { name = "Level", value = tostring(snap.level or 0), inline = true }
		fields[#fields + 1] = { name = "Prestige", value = "P" .. tostring(snap.prestige or 0), inline = true }
	end
	fields[#fields + 1] = { name = "Kill Streak", value = tostring(H.Stats.streak or 0), inline = true }
	fields[#fields + 1] = { name = "Shadow Ban", value = H.Stats.shadowBan and "BANNED" or "Clean", inline = true }
	return fields
end

function H.StatsWebhook.checkEvents()
	if H.StatsWebhook.url() == "" then return end
	local last = H.StatsWebhook.lastEvent
	local snap = H.Prestige.snapshot()
	if H.Stats.currentSlot ~= last.slot then
		last.slot, last.level, last.prestige, last.shadowBan = H.Stats.currentSlot, snap and snap.level, snap and snap.prestige, H.Stats.shadowBan
		return
	end
	if snap then
		if last.prestige and snap.prestige > last.prestige then
			H.StatsWebhook.send("Prestige Up!", string.format("%s reached **P%d**", H.userTag(), snap.prestige), 15844367, H.StatsWebhook.progressFields(), { mention = true })
		elseif last.level and snap.level > last.level then
			H.StatsWebhook.send("Level Up!", string.format("%s is now **Level %d**", H.userTag(), snap.level), 3447003, H.StatsWebhook.progressFields())
		end
		last.level, last.prestige = snap.level, snap.prestige
	end
	if last.shadowBan ~= true and H.Stats.shadowBan == true then
		H.StatsWebhook.send("Shadow Ban Detected", string.format("%s is banned", H.userTag()), 15158332, H.StatsWebhook.progressFields(), { mention = true })
	end
	last.shadowBan = H.Stats.shadowBan
end

function H.StatsWebhook.sessionReport(outcome, runType, payload)
	if H.StatsWebhook.url() == "" then return end
	payload = payload or {}
	local fields = {
		{ name = "Account", value = string.format("**User:** %s\n**Executor:** %s", H.userTag(), tostring(identify_ and select(1, identify_()) or "Unknown")), inline = true },
	}
	local snap = H.Prestige.snapshot()
	fields[#fields + 1] = {
		name = "Progression",
		value = string.format("**Level:** %s\n**Prestige:** P%s\n**Streak:** %s", snap and tostring(snap.level) or "?", snap and tostring(snap.prestige) or "0", H.commas(H.Stats.streak or 0)),
		inline = true,
	}
	local combat = {}
	if (payload.seconds or 0) > 0 then combat[#combat + 1] = "**Time:** " .. H.clockFmt(payload.seconds) end
	if payload.kills then combat[#combat + 1] = "**Kills:** " .. H.commas(payload.kills) end
	if payload.damage then combat[#combat + 1] = "**Damage:** " .. H.commas(payload.damage) end
	if #combat > 0 then fields[#fields + 1] = { name = "Combat", value = table.concat(combat, "\n"), inline = true } end
	if payload.rewards and next(payload.rewards) then
		local lines = {}
		for name, amount in pairs(payload.rewards) do lines[#lines + 1] = string.format("**%s** x %s", name, H.commas(amount)) end
		table.sort(lines)
		fields[#fields + 1] = { name = "Rewards", value = table.concat(lines, "\n"), inline = true }
	end
	if payload.drops and #payload.drops > 0 then
		local lines = {}
		for _, drop in ipairs(payload.drops) do lines[#lines + 1] = "✨ " .. tostring(drop) end
		fields[#fields + 1] = { name = "Drops", value = table.concat(lines, "\n"), inline = true }
	end
	local function stat(k) return H.commas(H.Stats[k] or 0) end
	fields[#fields + 1] = {
		name = "Lifetime",
		value = string.format("Missions `%s` · Raids `%s` · Waves `%s` · Kills `%s`\nGold `%s` · Gems `%s` · EXP `%s`\nEpic `%s` · Legendary `%s` · Mythic `%s`",
			stat("MissionsCompleted"), stat("RaidsCompleted"), stat("WavesCompleted"), stat("titanKills"),
			stat("GoldCollected"), stat("GemsCollected"), stat("ExpCollected"),
			stat("EpicPerksCollected"), stat("LegendaryPerks"), stat("MythicPerks")),
		inline = false,
	}
	local rare = payload.drops and #payload.drops > 0
	local title, color, description
	if outcome == "win" then
		title, color = "Run Completed", rare and 15844367 or 3066993
		description = rare and "Rare drop — see Drops." or string.format("%s finished a run.", H.userTag())
	elseif outcome == "fail" then
		title, color, description = "Run Failed", 15158332, string.format("%s failed a run.", H.userTag())
	else
		title, color, description = "Stats Report", 5793266, string.format("Manual report for %s.", H.userTag())
	end
	H.StatsWebhook.send(title, description, color, fields, {
		thumbnail = string.format("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=150&height=150&format=png", REAL_USERID),
		mention = rare,
	})
end

function H.Reward.updateStat(key, value)
	if (value or 0) <= 0 then return end
	H.Stats[key] = value
	local label = H.UI.statsLabels[key]
	if label then H.UI.setParagraph(label, tostring(value)) end
