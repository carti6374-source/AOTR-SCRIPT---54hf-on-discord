H.task("Attack", function(self)
	while not self.cancelled do
		task.wait(H.Anti.gap(H.T.TICK))
		if self.cancelled then return end
		if workspace:GetAttribute("Rewarded") or workspace:GetAttribute("Force_End") then continue end
		if H.Cutscene.active() then H.Runtime.shiftAnimUntil = os.clock() + 5 continue end
		if os.clock() < H.Runtime.shiftAnimUntil then continue end

		local titan, nape = H.Runtime.currentTitan, H.Runtime.nape
		if not (titan and nape and nape.Parent and titan.Parent and titan:FindFirstChildOfClass("Humanoid")) then continue end

		if H.Colossal.active() then
			local isBoss = titan == H.Colossal.boss()
			if H.Colossal.phase() == 1 then
				if isBoss then continue end
				local _, root = H.Char.get()
				if not root or root:FindFirstChild("Cannon") then continue end
			end
			if not isBoss then
				local eren = H.Colossal.erenPos()
				if eren and (nape.Position - eren).Magnitude > H.Colossal.EREN_RADIUS then continue end
			end
		end

		local objective, type_ = workspace:GetAttribute("Objective"), workspace:GetAttribute("Type")
		local skip = false
		if (type_ == "Raids" and objective == "Attack Titan") or objective == "Armored Titan" then
			local objectives = RS:FindFirstChild("Objectives")
			if objectives and (objectives:FindFirstChild("Defeat_Attack_Titan") or objectives:FindFirstChild("Defeat_Armored_Titan")) then
				skip = true
				local bossNape = H.Target.raidBossNape()
				if bossNape and bossNape.Parent and (nape.Position - bossNape.Position).Magnitude <= 100 then skip = false end
			end
		end
		if skip then continue end

		local seconds = workspace:GetAttribute("Seconds") or 0
		if seconds ~= H.Runtime.safetySecVal then
			H.Runtime.safetySecVal, H.Runtime.safetySecStamp = seconds, os.clock()
		end
		local frozen = os.clock() - H.Runtime.safetySecStamp > H.T.SAFETY_STALE
		local safetyLimit = type_ == "Missions" and H.Config.MissionSafetyTimer or (type_ == "Raids" and H.Config.RaidSafetyTimer or nil)

		local holdBoss = type_ == "Raids" and H.Config.RaidBossHpHold
		if holdBoss and safetyLimit and seconds >= safetyLimit then holdBoss = false end
		if holdBoss then
			local pct = H.Target.raidBossHpPct()
			if pct and pct <= H.clamp(H.Config.RaidBossHpThreshold, 5, 50) then
				local chip = true
				if frozen then
					chip = os.clock() - H.Runtime.bossHpChipTick >= 1.5
					if chip then H.Runtime.bossHpChipTick = os.clock() end
				end
				if chip then
					local _, root = H.Char.get()
					local small, smallTitan = H.Target.smallTitanNape(root and root.Position)
					if small and smallTitan then
						H.Runtime.nape, H.Runtime.currentTitan = small, smallTitan
					else continue end
				end
			end
		end

		if safetyLimit and seconds < safetyLimit and not frozen then
			local node
			local objectives = RS:FindFirstChild("Objectives")
			if objectives then
				for _, child in ipairs(objectives:GetChildren()) do
					local n = child.Name
					if n == "Slay" or n == "Kill" or n == "Defend" or n == "Protect" or n == "Guard" or n == "Protect_HQ" then
						node = child
						break
					end
				end
			end
			if node then
				local value = node.Value or 0
				local req = node:GetAttribute("Requirement") or 0
				local need = math.max(1, H.num(H.Config.MultiHit, 1))
				local hold
				if node.Name == "Slay" or node.Name == "Kill" then hold = req > 1 and req - need <= value
				else hold = req > 1 and req - 2 <= value end
				if hold then
					if not H.Runtime.safetyNotifyTick or os.clock() - H.Runtime.safetyNotifyTick >= H.T.NOTIFY_GAP then
						H.Runtime.safetyNotifyTick = os.clock()
						H.notify("Safety Timer", string.format("Holding %s %d/%d", node.Name, value, req), 9, "clock")
					end
					continue
				end
			end
		end

		local shifting = LP:GetAttribute("Shifting") == true
		if not shifting and LP:GetAttribute("Weapon") ~= "Spears" then
			local blade = H.Char.blade()
			if blade and blade.Transparency == 1 then continue end
		end

		H.Combat.attack()
		H.Anti.pauseIfNeeded()

		if H.Config.AutoUseSkills then
			local target = H.Combat.hasTarget(500)
			if not shifting and target and os.clock() - H.Runtime.lastHumanSkillTick > 0.6 then
				local slots = H.Combat.humanSkillSlots()
				if slots and #slots > 0 then
					H.Runtime.lastHumanSkillTick = os.clock()
					if H.Runtime.humanRotIdx > #slots then H.Runtime.humanRotIdx = 1 end
					local slot = slots[H.Runtime.humanRotIdx]
					H.Runtime.humanRotIdx = H.Runtime.humanRotIdx % #slots + 1
					local id = H.Stats.hotbar and H.Stats.hotbar[slot]
					H.Combat.fireSkill(slot, target.Position, id and H.SKILL.LOCATION[id] == "tbl")
				end
			end
		end
	end
end, function() H.Move.cancel() end)

H.task("Movement", function(self)
	while not self.cancelled do
		task.wait(0.1)
		if self.cancelled then return end
		local _, root = H.Char.get()
		if not root then continue end
		H.Target.update()
		if H.Runtime.objectiveMode then continue end

		if H.Config.AutoTitanMastery and LP:GetAttribute("Shifting") == true then
			local nape, titan = H.Runtime.nape, H.Runtime.currentTitan
			if nape and nape.Parent then
				local anchor = titan and (titan.PrimaryPart or titan:FindFirstChild("HumanoidRootPart") or titan:FindFirstChild("Torso"))
				if anchor then
					local look = anchor.CFrame.LookVector
					local point = anchor.Position - look * 40
					H.Move.to(root, Vector3.new(point.X, nape.Position.Y, point.Z), look)
				else
					local offset = root.Position - nape.Position
					local dir = offset.Magnitude > 0.1 and offset.Unit or Vector3.new(0, 0, 1)
					H.Move.to(root, nape.Position + dir * 40, -dir)
				end
			else H.Move.cancel() end
			continue
		end

		local objective, moving = H.Target.movingObjective()
		if objective and moving then
			H.Move.to(root, objective + Vector3.new(0, H.Config.HoverHeight, 0))
			continue
		end

		local bossNape = H.Target.raidBossNape()
		H.Runtime.bossHover = bossNape ~= nil
		if bossNape then
			local point = bossNape.Position + Vector3.new(0, H.Config.HoverHeight, 0)
			H.Move.to(root, H.Combat.chaseHold(point, 1000, H.Config.HoverHeight))
			continue
		end

		local nape = H.Runtime.nape
		if nape and nape.Parent then
			H.Move.to(root, nape.Position + Vector3.new(0, H.Config.HoverHeight, 0))
		else
			H.Move.cancel()
			H.Runtime.currentTitan, H.Runtime.nape = nil, nil
		end
	end
end, function() H.Move.cancel() end)

