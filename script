---------------------------------------------------------------------

H.Lobby.waitUI = function(timeout)
	local deadline = os.clock() + (timeout or 30)
	while os.clock() < deadline and not H.gui({ "Interface", "Topbar" }) do task.wait(1) end
	return H.gui({ "Interface", "Topbar" }) ~= nil
end

