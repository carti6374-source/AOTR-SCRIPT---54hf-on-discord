function H.Theme.spec()
	local spec = { Name = "Custom" }
	for _, field in ipairs(THEME_FIELDS) do
		local hex = H.Theme.custom[field]
		if hex then spec[field] = Color3.fromHex(hex) end
	end
	return spec
end

function H.Theme.applyCustom()
	H.Theme.count = H.Theme.count + 1
	local spec = H.Theme.spec()
	spec.Name = "Custom" .. H.Theme.count
	pcall(function() H.UI.WindUI:AddTheme(spec) end)
	pcall(function() H.UI.Window:SetTheme(spec.Name) end)
	H.Config.ThemeName = "Custom"
	H.UI.saveConfig()
end

function H.Theme.set(field, color)
	H.Theme.custom[field] = tostring(color):gsub("^Color3", "")
	local ok, hex = pcall(function()
		return string.format("%02X%02X%02X", math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
	end)
	if ok then H.Theme.custom[field] = "#" .. hex end
end

function H.Theme.export()
	local payload = { version = H.VERSION, fields = H.Theme.custom }
	return "MH1:" .. H.b64enc(Http:JSONEncode(payload))
end

function H.Theme.import(code)
	code = H.trim(code)
	if code:sub(1, 4) ~= "MH1:" then return false, "Not a theme code" end
	local ok, data = pcall(function() return Http:JSONDecode(H.b64dec(code:sub(5))) end)
	if not ok or type(data) ~= "table" or type(data.fields) ~= "table" then return false, "Corrupt code" end
	for _, field in ipairs(THEME_FIELDS) do
		if type(data.fields[field]) == "string" then H.Theme.custom[field] = data.fields[field] end
	end
	H.Theme.applyCustom()
	return true
end

