H.Move = { dest = nil, face = nil, conn = nil, autoRotHum = nil, ARRIVE = 3 }

function H.Move.ensure()
	if H.Move.conn then return end
	H.Move.conn = RunService.Heartbeat:Connect(function(dt)
		local dest = H.Move.dest
		local _, root, hum = H.Char.get()
		if not dest then
			if H.Move.autoRotHum then pcall(function() H.Move.autoRotHum.AutoRotate = true end) H.Move.autoRotHum = nil end
			return
		end
		if not root then return end
		if hum and H.Move.autoRotHum ~= hum then
			local old = H.Move.autoRotHum
			if old then pcall(function() old.AutoRotate = true end) end
			pcall(function() hum.AutoRotate = false end)
			H.Move.autoRotHum = hum
		end
		if root.Anchored then return end

		local pos = root.Position
		if (pos - dest).Magnitude <= H.Move.ARRIVE then return end

		local speed = H.num(H.Config.HoverSpeed, 1500)
		local alpha = 1 - math.exp(-math.clamp(speed / 130, 4, 16) * math.min(dt, 0.1))
		local target = pos:Lerp(dest, alpha)

		-- teleport distance cap: keeps per-frame deltas under anticheat thresholds
		local cap = H.num(H.Config.TeleportCap, 900)
		if (target - pos).Magnitude > cap then target = pos + (target - pos).Unit * cap end

		local face = H.Move.face
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			local base = CFrame.new(target) * (root.CFrame - root.CFrame.Position)
			if face and face.Magnitude > 0.01 then
				root.CFrame = base:Lerp(CFrame.lookAt(target, target + face), alpha)
			else
				root.CFrame = base
			end
		end)
	end)
	H.connect("MoveEngine", H.Move.conn)
end

function H.Move.to(root, dest, face)
	if typeof(dest) ~= "Vector3" then return end
	H.Move.ensure()
	H.Move.dest = dest
	H.Move.face = typeof(face) == "Vector3" and face or nil
	if root and root.Anchored then root.Anchored = false end
end

function H.Move.hold(root)
	H.Move.dest = nil
	if root then root.Anchored = true end
end

function H.Move.cancel()
	H.Move.dest, H.Move.face = nil, nil
	local _, root = H.Char.get()
	if not root then return end
	pcall(function()
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.Anchored = false
	end)
end

