H.Net = {}
local exprCache = setmetatable({}, { __mode = "v" })

local function compileExpr(expr)
	local fn = exprCache[expr]
	if fn then return fn end
	local chunk = loadstring_("local a, b, c, out = ...; local res = a; " .. expr .. "; return out")
	if not chunk then return nil end
	exprCache[expr] = chunk
	return chunk
end

function H.Net.remote(kind)
	local assets = RS:FindFirstChild("Assets")
	local remotes = assets and assets:FindFirstChild("Remotes")
	return remotes and remotes:FindFirstChild(kind)
end

function H.Net.call(kind, timeout, ...)
	if H.Anti.dryRun then
		if not H.Anti.take() then return nil, "rate" end
		H.log("DRY", kind, ...)
		return true, nil
	end
	if not H.Anti.take() then return nil, "rate" end

	local remote = H.Net.remote(kind)
	if not remote then return false end

	local done, results = false, table.pack()
	task.spawn(function()
		local packed = table.pack(pcall(remote.InvokeServer, remote, ...))
		done = true
		if packed[1] then results = table.pack(true, packed[2], packed[3], packed[4]) end
	end)

	local deadline = os.clock() + (timeout or 5)
	while not done and os.clock() < deadline do task.wait(0.02) end
	if not done then return nil, "timeout" end
	return table.unpack(results, 1, results.n)
end

function H.Net.fire(kind, ...)
	if H.Anti.dryRun then
		if not H.Anti.take() then return end
		H.log("DRY fire", kind, ...)
		return
	end
	if not H.Anti.take() then return end
	local remote = H.Net.remote(kind)
	if not remote then return end
	pcall(remote.FireServer, remote, ...)
end

function H.Net.invoke(kind, a, b, opts)
	opts = opts or {}
	local map = opts.map or "out = (res ~= nil)"

	local packed
	if opts.args then
		packed = table.pack(H.Net.call(kind, opts.timeout or 6, table.unpack(opts.args)))
	else
		packed = table.pack(H.Net.call(kind, opts.timeout or 6, a, b))
	end

	if packed[1] == nil then return { ok = false, err = packed[2] or "timeout" } end
	if packed[1] == false then return { ok = false, err = "no_remote" } end

	local chunk = compileExpr(map)
	if not chunk then return { ok = false, err = "bad_expr" } end

	local ok, mapped = pcall(chunk, packed[2], packed[3], packed[4])
	if not ok then return { ok = false, err = tostring(mapped) } end
	return { ok = true, data = mapped }
end

function H.Net.post(a, b, opts) return H.Net.invoke("POST", a, b, opts) end
function H.Net.get(a, b, opts) return H.Net.invoke("GET", a, b, opts) end

function H.Net.actor(a, b, opts)
	local res = H.Net.post(a, b, opts)
	if res and res.ok then return res end
	if res and res.err == "no_remote" then return H.Net.get(a, b, opts) end
	return res
end

