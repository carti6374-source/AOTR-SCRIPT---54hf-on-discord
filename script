	if not entry or not entry.tab then return end
	pcall(function() entry.tab:Select() end)
	if entry.section then pcall(function() entry.section:Open() end) end
	if entry.obj then
		pcall(function()
			for _ = 1, 3 do
				local parent = entry.obj.Parent
				if parent and parent:IsA("GuiObject") then
					parent.BackgroundTransparency = 0.4
					task.wait(0.12)
					parent.BackgroundTransparency = 1
					task.wait(0.12)
				end
			end
		end)
	end
end

