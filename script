local WINDUI_CACHE = "MahmutHub_WindUI.luau"
local WINDUI_MIN = 1000

local function httpGet(url)
	if request_ then
		local ok, res = pcall(request_, { Url = url, Method = "GET" })
		if ok and type(res) == "table" and type(res.Body) == "string" then return res.Body end
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok and type(body) == "string" then return body end
	return nil
end

local function loadChunk(source)
	if type(source) ~= "string" or #source < WINDUI_MIN then return nil end
	local chunk = loadstring_(source)
	if not chunk then return nil end
	local ok, result = pcall(chunk)
	if ok and type(result) == "table" then return result end
	return nil
end

local function loadWindUI()
	local cached = isfile_ and readfile_ and isfile_(WINDUI_CACHE) and readfile_(WINDUI_CACHE)
	if cached then
		local ui = loadChunk(cached)
		if ui then return ui end
	end
	for pass = 1, 2 do
		for _, url in ipairs(WINDUI_URLS) do
			local ui = loadChunk(httpGet(url))
			if ui then
				if writefile_ then pcall(writefile_, WINDUI_CACHE, httpGet(url) or "") end
				return ui
			end
		end
		if pass == 1 then task.wait(1.5) end
	end
	return nil
end

