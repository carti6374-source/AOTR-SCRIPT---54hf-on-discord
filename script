H.task("TitanMastery", function(self)
	while not self.cancelled do
		task.wait(0.3)
		if self.cancelled or not (H.Runtime.farming and H.Config.AutoTitanMastery and H.isInGame()) then continue end
		if workspace:GetAttribute("Rewarded") or workspace:GetAttribute("Force_End") then continue end
		local shifted = LP:GetAttribute("Shifting") == true
		local bar = tonumber(LP:GetAttribute("Bar")) or 0
		local maxBar = tonumber(LP:GetAttribute("Max_Bar")) or 100
		local now = os.clock()
		if shifted ~= H.Runtime.titanShifted then
			H.Runtime.titanShifted = shifted
			if shifted then H.Runtime.skillRotIdx = 1 H.Runtime.shiftAnimUntil = now + 2.5 end
		end
		if shifted then
			if now >= H.Runtime.shiftAnimUntil and H.Combat.hasTarget(500) and now - H.Runtime.lastSkillTick > 0.6 then
				H.Runtime.lastSkillTick = now
				local idx = H.Runtime.skillRotIdx
				for _ = 1, 5 do
					if not H.Runtime.ejectSlots[idx] then break end
					idx = idx % 5 + 1
				end
				if H.Runtime.tossSlots[idx] then
					local _, root = H.Char.get()
					local point = root and (root.Position + root.CFrame.LookVector * 80) or (H.Runtime.nape and H.Runtime.nape.Position)
					H.Combat.fireSkill(idx, point)
					for _ = 1, 4 do
						task.wait(0.5)
						if LP:GetAttribute("Target") == nil then break end
						H.Combat.fireSkill(idx, point)
					end
				elseif not H.Runtime.ejectSlots[idx] then
					H.Combat.fireSkill(idx)
				end
				H.Runtime.skillRotIdx = idx % 5 + 1
			end
		elseif maxBar <= bar and now - H.Runtime.lastShiftTick > 2 then
			H.Runtime.lastShiftTick = now
			local slot = H.Combat.shiftSlot()
			if slot then H.Combat.fireSkill(slot) end
		end
