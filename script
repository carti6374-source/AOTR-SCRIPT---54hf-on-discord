H.connect("CursorWatch", task.spawn(function()
	while true do
		repeat task.wait(0.5) until H.isInGame()
		UIS.MouseIconEnabled = true
		task.wait(0.5)
	end
end))

UIS.WindowFocusReleased:Connect(function()
	H.connect("BlurMouse", RunService.RenderStepped:Connect(function()
		UIS.MouseBehavior = Enum.MouseBehavior.Default
		UIS.MouseIconEnabled = true
	end))
end)
UIS.WindowFocused:Connect(function() H.disconnect("BlurMouse") end)

