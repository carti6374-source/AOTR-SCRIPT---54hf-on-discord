H.Farm = {}

function H.Farm.leaveToLobby(timeout)
	local deadline = os.clock() + (timeout or 30)
	while H.isInGame() and os.clock() < deadline do
		H.Net.fire(H.REMOTE.POST, "Functions", "Teleport")
		task.wait(2)
	end
	return not H.isInGame()
end

function H.Farm.start()
	if H.Runtime.farming then return end
	H.Runtime.farming = true
	H.Runtime.runState = "starting"
	H.Stats.FarmStartTime = os.clock()
	H.Runtime.sessionStartTick = os.clock()
	H.Runtime.currentTitan, H.Runtime.nape = nil, nil
	H.Runtime.attackCombo, H.Runtime.safetySecVal = 0, nil
	H.RewardHook.reset()

	H.Anti.start()
	H.Tasks.Attack:start()
	H.Tasks.Movement:start()
	H.Tasks.WaveMonitor:start()
	H.Tasks.Reload:start()
	H.Cutscene.startMonitor()
	H.Colossal.startMonitor()
	H.Escape.setup()
	if H.Config.TitanESP then H.ESP.build() end
	if H.Config.NapeExtender then H.Nape.startMonitor() end
	if H.Config.AutoDie then H.Tasks.StreakWatch:start() end
	if H.Config.AutoTitanMastery then H.Tasks.TitanMastery:start() end
	H.RewardHook.start()

	task.spawn(function()
		task.wait(H.Config.WaitBeforeFarm)
		if not H.Runtime.farming then return end
		local deadline = os.clock() + 30
		while os.clock() < deadline and H.visible(H.gui(H.PATH.LOADING)) do task.wait(1) end
		if not H.Runtime.farming then return end
		local rootDeadline = os.clock() + 15
		while os.clock() < rootDeadline and not H.Char.get() do task.wait(0.5) end
		if not H.Runtime.farming then return end
		H.Char.anchor(true)
		H.Noclip.start()
		H.Runtime.runState = "farming"
		H.Perf.applyAll()
		if H.Config.SoloOnly then H.SoloOnly.setup() end
	end)

	H.UI.refreshFarmStatus()
end

function H.Farm.stop()
	if not H.Runtime.farming then return end
	H.Runtime.farming = false
	H.Runtime.runState = "idle"
	H.Runtime.bossHover, H.Runtime.objectiveMode = false, false
	H.Runtime.attackBlockedTick, H.Runtime.fullReloadCooldownTick = 0, 0
	H.Runtime.isReloading, H.Runtime.titanShifted = false, false
	H.Runtime.currentTitan, H.Runtime.nape = nil, nil

	H.Tasks.Attack:stop()
	H.Tasks.Movement:stop()
	H.Tasks.WaveMonitor:stop()
	H.Tasks.StreakWatch:stop()
	H.Tasks.TitanMastery:stop()
	H.Cutscene.stopMonitor()
	H.Colossal.stopMonitor()
	H.Noclip.stop()
	H.ESP.clear()
	H.Nape.stopMonitor()
	H.Escape.teardown()
	H.RewardHook.stop()
	H.Anti.stop()
	H.Move.cancel()
	H.Char.anchor(false)
	H.UI.refreshFarmStatus()
end

H.SoloOnly = {}

function H.SoloOnly.setup()
	H.disconnect("SoloOnly")
	if not H.Config.SoloOnly or not (H.Runtime.farming and H.isInGame()) then return end
	local function leave(name)
		H.notify("Solo Only", name .. " joined, leaving", 5, "log-out")
		H.Farm.stop()
		task.delay(0.5, function() H.Farm.leaveToLobby(30) end)
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LP then leave(player.Name) return end
	end
	H.connect("SoloOnly", Players.PlayerAdded:Connect(function(player)
		if player == LP then return end
		if H.Config.SoloOnly and H.Runtime.farming and H.isInGame() then leave(player.Name) end
	end))
end

