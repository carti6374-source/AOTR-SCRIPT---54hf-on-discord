    slot = tostring(slot or ""), level = tonumber(prog.Level) or 0, prestige = tonumber(prog.Prestige) or 0,
    streak = tonumber(streak and streak.Total) or 0, titanKills = tonumber(kills and kills.Total) or 0,
    disabled = (type(disabled) == "string" and disabled ~= "") and disabled or false,
    weapon = weapon, upgrades = upMap, potential = count > 0 and math.floor(total / count) or 0,
    hotbar = hotbar, shiftSlot = shift, ejectSlots = eject, tossSlots = toss,
    perkStorage = storage, unlockedSkills = unlocked,
}
]]

function H.DataCopy.fetch(force)
	if H.DataCopy.fetching then return false end
	if not force and os.clock() - (H.Stats.dataCopyStamp or 0) < H.DataCopy.TTL then return false end
	H.DataCopy.fetching = true
	local res = H.Net.actor("Functions", "Settings", {
		args = { "Functions", "Settings", "Blur", "Off" }, map = H.DataCopy.MAP, timeout = 10,
	})
	H.DataCopy.fetching = false
	if not res or not res.ok or type(res.data) ~= "table" then
		H.log("datacopy failed:", res and res.err or "nil")
		return false
	end
	return H.DataCopy.apply(res.data)
end

function H.DataCopy.apply(data)
	H.Stats.dataCopyStamp = os.clock()
	if data.weapon then H.Stats.weapon = data.weapon end
	if data.weapon and type(data.upgrades) == "table" then H.Stats.upgrades[data.weapon] = data.upgrades end
	H.Stats.potential = data.potential or 0

	if type(data.hotbar) == "table" then
		local hotbar, human = {}, {}
		for i = 1, 5 do
			local id = tostring(data.hotbar[i] or "")
			hotbar[i] = id
			if id ~= "" and id ~= H.SKILL.SHIFT_SLOT and id ~= "nil" then human[#human + 1] = i end
		end
		H.Stats.hotbar = hotbar
		H.Runtime.humanSkillSlots = human
	end

	H.Runtime.shiftSlot = data.shiftSlot
	H.Runtime.ejectSlots, H.Runtime.tossSlots = {}, {}
	for k in pairs(data.ejectSlots or {}) do H.Runtime.ejectSlots[tonumber(k)] = true end
	for k in pairs(data.tossSlots or {}) do H.Runtime.tossSlots[tonumber(k)] = true end

	H.Stats.shadowBan = data.disabled and true or false
	H.Stats.disabledReason = data.disabled and tostring(data.disabled) or nil
	H.Stats.streak = data.streak or 0
	H.Stats.titanKills = data.titanKills or H.Stats.titanKills or 0
	if type(data.unlockedSkills) == "table" then H.Stats.unlockedSkills = data.unlockedSkills end

	if type(data.perkStorage) == "table" and #data.perkStorage > 0 then
		local rarityOf = {}
		local ok = pcall(function()
			local Perks = require(RS.Modules.Storage.Perks)
			for tier, bucket in pairs(Perks) do
				if type(bucket) == "table" and type(tier) == "string" then
					for name in pairs(bucket) do if type(name) == "string" then rarityOf[name] = tier end end
				end
			end
		end)
		if ok then
			for _, perk in ipairs(data.perkStorage) do perk.rarity = rarityOf[perk.name] or "Unknown" end
			H.Stats.perkStorage = data.perkStorage
		end
	end

	if data.slot == "" then task.defer(H.DB.save) return true end

	H.Stats.currentSlot = data.slot
	local ready = data.prestige < H.Prestige.MAX_TIER and data.level >= H.Prestige.maxLevel(data.prestige)
	H.Stats.prestigeSnapshot[data.slot] = { level = data.level, prestige = data.prestige, ready = ready }
	H.Stats.prestigeStamp = os.clock()
	task.defer(H.DB.save)
	return true
end

