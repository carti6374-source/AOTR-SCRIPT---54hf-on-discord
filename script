H.Thunder = { SUPPLY_RADIUS = 150, _sawDefend = false }

local function colliderOf(inst)
	if not inst then return nil end
	local hitbox = inst:FindFirstChild("Hitbox", true)
	if hitbox and hitbox:IsA("BasePart") then return hitbox end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") and d:FindFirstChildWhichIsA("TouchTransmitter") then return d end
	end
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") and inst.PrimaryPart then return inst.PrimaryPart end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

function H.Thunder.readProgress()
	local wanted = {}
	for _, tag in ipairs(H.QUEST_TAGS) do wanted[tag] = true end
	local out = {}
	local interface = H.gui({ "Interface" })
	if not interface then return out end
	for _, d in ipairs(interface:GetDescendants()) do
		if d.Name == "Tag" and d:IsA("TextLabel") then
			local key = tostring(d.Text):upper()
			if wanted[key] then
				local parent = d.Parent
				local amount = H.safeIndex(parent, "Bar", "Amount")
				local current, target
				if amount and amount:IsA("TextLabel") then current, target = amount.Text:match("([%d%.]+)%s*/%s*([%d%.]+)") end
				local claimed = H.safeIndex(parent, "Claimed")
				local title = claimed and H.safeIndex(claimed, "Title")
				local titleText = title and title:IsA("TextLabel") and title.Text or ""
				local visible = H.visible(claimed)
				local locked = visible and titleText:upper():find("LOCK") ~= nil
				out[key] = { current = tonumber(current) or 0, target = tonumber(target) or 0, claimed = visible and not locked, locked = locked }
			end
		end
	end
	if next(out) then H.Lobby.questCache = out end
	return out
end

function H.Thunder.openPanel()
	local deadline = os.clock() + 4
	local interact
	while os.clock() < deadline do
		if H.visible(H.gui({ "Interface", "Topbar" })) then
			interact = H.gui(H.PATH.QUEST_INTERACT)
			if interact then break end
		end
		task.wait(0.5)
	end
	if not interact then task.wait(3) return {} end
	H.UI.clickGui(interact)
	task.wait(0.3)

	local rows = H.gui(H.PATH.QUEST_ROWS)
	if rows then
		local q21 = rows:FindFirstChild("Q_2.1")
		if q21 then
			H.UI.clickGui(H.safeIndex(q21, "Inner", "Interact"))
		else
			for _, row in ipairs(rows:GetChildren()) do
				local tag = H.safeIndex(row, "Inner", "Tag")
				if tag and tag:IsA("TextLabel") and table.find(H.QUEST_TAGS, tostring(tag.Text):upper()) then
					H.UI.clickGui(H.safeIndex(row, "Inner", "Interact"))
					break
				end
			end
		end
	end

	local deadline2 = os.clock() + 4
	local data
	repeat task.wait(0.8) data = H.Thunder.readProgress() until next(data) or os.clock() > deadline2
	GuiService.SelectedObject = nil
	return data or {}
end

function H.Thunder.missionDone(quest, progress)
	for _, tag in ipairs(quest.tags) do
		local entry = progress[tag]
		if not (entry and (entry.claimed or (entry.target > 0 and entry.current >= entry.target))) then return false end
	end
	return true
end

function H.Thunder.progressString(quest, progress)
	local parts = {}
	for _, tag in ipairs(quest.tags) do
		local entry = progress[tag]
		parts[#parts + 1] = tag .. " " .. (entry and (entry.claimed and "done" or (entry.current .. "/" .. entry.target)) or "?")
	end
	return table.concat(parts, ", ")
end

function H.Thunder.nextQuest(progress)
	for _, quest in ipairs(H.QUESTS) do
		if not H.Thunder.missionDone(quest, progress) and not H.Lobby.thunderRan[quest.name] then return quest end
	end
	return nil
end

function H.Thunder.supplyCrate()
	local unclimbable = workspace:FindFirstChild("Unclimbable")
	local objective = unclimbable and unclimbable:FindFirstChild("Objective")
	for _, root in ipairs({ objective, unclimbable, workspace }) do
		if root then
			for _, child in ipairs(root:GetChildren()) do
				if child.Name:lower():match("^supplies_c") then
					local part = colliderOf(child)
					if part and part:IsA("BasePart") then return child, part end
				end
			end
		end
	end
	return nil, nil
end

function H.Thunder.defendNode()
	for _, root in ipairs({ RS:FindFirstChild("Objectives"), H.safeIndex(workspace, "Unclimbable", "Objective") }) do
		if root then
			local node = root:FindFirstChild("Defend_Supplies")
			if node then return node end
		end
	end
	return nil
end

function H.Thunder.defendingSupplies()
	local node = H.Thunder.defendNode()
	if not node then return false end
	local req = node:GetAttribute("Requirement")
	local value = tonumber(node.Value) or 0
	if req and req > 0 and req <= value then return false end
	H.Thunder._sawDefend = true
	return true
end

function H.Thunder.supplyPos()
	local _, part = H.Thunder.supplyCrate()
	return part and part.Position or nil
end

function H.Thunder.slayNode()
	for _, root in ipairs({ RS:FindFirstChild("Objectives"), H.safeIndex(workspace, "Unclimbable", "Objective") }) do
		if root then
			local node = root:FindFirstChild("Slay") or root:FindFirstChild("Kill")
			if node then return node end
		end
	end
	return nil
end

function H.Thunder.shouldLeaveDefend()
	if not H.Thunder.defendNode() then return H.Thunder._sawDefend and "defend vanished" or nil end
	if H.Thunder._sawDefend then
		local slay = H.Thunder.slayNode()
		if slay then
			local req = slay:GetAttribute("Requirement")
			local value = tonumber(slay.Value) or 0
			if req and req > 0 and req - 10 <= value then return "slay near requirement" end
		end
	end
	return nil
end

function H.Thunder.towerTarget()
	local best, bestN, count = nil, math.huge, 0
	local ok, tagged = pcall(function() return CS:GetTagged("TS_Towers") end)
	if not ok then return nil, 0 end
	for _, tower in ipairs(tagged) do
		local n = tower.Name:lower():match("^watchtower_(%d+)")
		if n then
			count = count + 1
			local part = colliderOf(tower)
			if part and part:IsA("BasePart") then
				local idx = tonumber(n)
				if idx < bestN then best, bestN = { inst = tower, part = part, n = idx }, idx end
			end
		end
	end
	return best, count
end

function H.Thunder.escortCart()
	local unclimbable = workspace:FindFirstChild("Unclimbable")
	local objective = unclimbable and unclimbable:FindFirstChild("Objective")
	for _, root in ipairs({ objective, unclimbable, workspace }) do
		if root then
			for _, child in ipairs(root:GetChildren()) do
				local cart = child:FindFirstChild("Cart", true)
				if cart and cart:IsA("BasePart") then return child, cart end
			end
		end
	end
	return nil, nil
end

function H.Thunder.runQuest(quest)
	local saved = {
		map = H.Lobby.missionMap, objective = H.Lobby.missionObjective,
		difficulty = H.Lobby.missionDifficulty, modifiers = H.Lobby.missionModifiers,
	}
	H.Lobby.questOverride = true
	H.Lobby.missionMap, H.Lobby.missionObjective, H.Lobby.missionDifficulty, H.Lobby.missionModifiers =
		quest.map, quest.objective, quest.difficulty, {}
	local ok, result = pcall(H.Session.createMission)
	H.Lobby.missionMap, H.Lobby.missionObjective, H.Lobby.missionDifficulty, H.Lobby.missionModifiers =
		saved.map, saved.objective, saved.difficulty, saved.modifiers
	H.Lobby.questOverride = false
	return ok and result or false
end

function H.Thunder.beginFarming()
	if H.Tasks.ThunderObjective:isRunning() then H.Runtime.objectiveMode = true return end
	H.Runtime.objectiveMode = true
	if not H.Runtime.farming then H.Farm.start() H.Thunder._startedFarm = true end
