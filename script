H.Anti = {
	tokens = 0,
	lastRefill = 0,
	dropped = 0,
	calls = 0,
	kicks = 0,
	backoff = 0,
	lastKick = 0,
}

function H.Anti.gap(base)
	local g = base
	if H.Config.GhostMode then g = g * H.num(H.Config.GhostFactor, 1.6) end
	if H.Config.Humanize then
		local pct = H.clamp(H.Config.Jitter, 0, 90) / 100
		g = g * (1 + (math.random() * 2 - 1) * pct)
	end
	return math.max(0.02, g)
end

function H.Anti.shouldPause()
	return H.Config.Humanize and math.random() * 100 < H.num(H.Config.PauseChance, 0)
end

function H.Anti.pauseIfNeeded()
	if H.Anti.shouldPause() then task.wait(math.random(30, 120) / 100) end
end

function H.Anti.refill()
	local now = os.clock()
	local dt = now - H.Anti.lastRefill
	H.Anti.lastRefill = now
	if not H.Config.RateLimit then return end
	local ceiling = H.num(H.Config.RateCeiling, 45)
	H.Anti.tokens = math.min(ceiling, H.Anti.tokens + dt * ceiling)
end

-- returns false when the bucket is empty (caller should skip)
function H.Anti.take()
	if not H.Config.RateLimit then return true end
	H.Anti.refill()
	if H.Anti.tokens >= 1 then
		H.Anti.tokens = H.Anti.tokens - 1
		H.Anti.calls = H.Anti.calls + 1
		return true
	end
	H.Anti.dropped = H.Anti.dropped + 1
	return false
end

function H.Anti.cps()
	return H.Anti.calls
end

function H.Anti.startStats()
	H.connect("RateStats", task.spawn(function()
		while true do
			task.wait(1)
			H.Anti.calls = 0
		end
	end))
end

function H.Anti.startKickGuard()
	if H.Conn.KickGuard then return end
	H.connect("KickGuard", LogService.MessageOut:Connect(function(message, kind)
		if kind ~= Enum.MessageType.MessageError then return end
		local lower = message:lower()
		if lower:find("kick") or lower:find("disconnect") or lower:find("lost connection") then
			H.Anti.onKick(lower)
		end
	end))
	H.connect("KickWatch", task.spawn(function()
		while true do
			task.wait(2)
			if LP.Parent == nil and H.Runtime.farming then H.Anti.onKick("player parent nil") end
		end
	end))
end

function H.Anti.stopKickGuard()
	H.disconnect("KickGuard")
	H.disconnect("KickWatch")
end

function H.Anti.onKick(reason)
	local now = os.clock()
	if now - H.Anti.lastKick < 5 then return end
	H.Anti.lastKick = now
	H.Anti.kicks = H.Anti.kicks + 1
	H.Anti.backoff = math.min(H.Anti.backoff + 1, 5)
	H.notify("Kick Guard", reason:sub(1, 90), 6, "wifi-off")
	if not H.Config.KickBackoff then return end
	local delay = math.min(2 ^ H.Anti.backoff, 60)
	H.log("backing off " .. delay .. "s")
	task.wait(delay)
end

function H.Anti.resetBackoff() H.Anti.backoff = 0 end

function H.Anti.startAfk()
	H.disconnect("AntiAfk")
	if not H.Config.AntiAfk then return end
	H.connect("AntiAfk", task.spawn(function()
		while true do
			task.wait(45)
			pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game) end)
			task.wait(0.1)
			pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end)
		end
	end))
end

function H.Anti.startFps()
	if not setfpscap_ then return end
	if H.Config.FpsGuard then pcall(setfpscap_, H.clamp(H.Config.FpsCap, 30, 240)) end
end

function H.Anti.stopFps()
	if setfpscap_ then pcall(setfpscap_, 240) end
end

function H.Anti.ping()
	local ok, ping = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
	return ok and ping or 0
end

function H.Anti.start()
	H.Anti.lastRefill = os.clock()
	H.Anti.tokens = H.num(H.Config.RateCeiling, 45)
	H.Anti.startStats()
	H.Anti.startKickGuard()
	H.Anti.startAfk()
	H.Anti.startFps()
end

