function H.UI.waitChild(parent, name, timeout)
	local deadline = os.clock() + (timeout or 5)
	while os.clock() < deadline do
		local child = parent and parent:FindFirstChild(name)
		if child and H.visible(child) then return child end
		task.wait(0.15)
	end
	return nil
end

