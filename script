function H.trim(s) return (tostring(s or ""):gsub("^%s*(.-)%s*$", "%1")) end
function H.clamp(n, lo, hi) return math.clamp(tonumber(n) or lo, lo, hi) end
function H.num(v, fb) return tonumber(v) or fb end
function H.copy(t) local o = {} for k, v in pairs(t or {}) do o[k] = v end return o end
function H.commas(n) return (tostring(math.floor(tonumber(n) or 0)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")) end
function H.clockFmt(s) s = math.max(0, math.floor(tonumber(s) or 0)) return string.format("%02d:%02d", math.floor(s / 60), s % 60) end
function H.userTag() return "||" .. REAL_NAME .. "||" end

function H.safeIndex(root, ...)
	local node = root
	for i = 1, select("#", ...) do
		if typeof(node) ~= "Instance" then return nil end
		local child = node:FindFirstChild((select(i, ...)))
		if not child then return nil end
		node = child
	end
	return node
end

function H.safePath(root, list)
	if typeof(root) ~= "Instance" then return nil end
	return H.safeIndex(root, table.unpack(list))
end

function H.gui(path) return H.safePath(LP:FindFirstChild("PlayerGui"), path) end

function H.visible(inst)
	if not inst then return false end
	local ok, v = pcall(function() return inst.Visible end)
	return ok and v == true
end

function H.copyToClipboard(text)
