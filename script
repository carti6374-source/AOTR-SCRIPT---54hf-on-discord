function H.Reward.clickRetry()
	task.wait(1)
	return H.UI.clickPath({ "Interface", "Rewards", "Main", "Info", "Main", "Buttons", "Retry" })
end

function H.Reward.clickRetrySure()
	for i = 1, 3 do
		H.Reward.clickRetry()
		local deadline = os.clock() + 8
		while os.clock() < deadline do
			if not H.Runtime.farming or not H.visible(H.gui(H.PATH.REWARDS)) then return true end
			task.wait(0.25)
		end
	end
	return false
end

function H.Reward.waitForRewardsThen(callback, delay)
	task.delay((delay or 0) + 0.5, function()
		if not H.Runtime.farming then return end
		local deadline = os.clock() + 20
		while os.clock() < deadline and H.Runtime.farming and not H.visible(H.gui(H.PATH.REWARDS)) do
			if H.Cutscene.active() then pcall(H.Cutscene.skip) end
			task.wait(0.15)
		end
		if not H.Runtime.farming then return end
		if not H.visible(H.gui(H.PATH.REWARDS)) then
			local chests = H.gui(H.PATH.CHESTS)
			if H.visible(chests) then
				local finish = H.UI.waitChild(chests, "Finish", 5)
				if finish then H.UI.clickGui(finish) task.wait(1.5) end
			end
		end
		local deadline2 = os.clock() + 10
		while os.clock() < deadline2 and H.Runtime.farming and H.visible(H.gui(H.PATH.REWARDS)) do task.wait(0.15) end
		if not H.Runtime.farming or H.visible(H.gui(H.PATH.REWARDS)) then return end
		callback()
	end)
end

function H.Reward.openChests()
	local deadline = os.clock() + 12
	local chests
	while os.clock() < deadline do
		chests = H.gui(H.PATH.CHESTS)
		if H.visible(chests) then break end
		task.wait(0.3)
	end
	if not H.visible(chests) then return false end
	local free = H.UI.waitChild(chests, "Free", 8)
	if free then H.UI.clickGui(free) end
	if H.Config.OpenBothChests then
		task.wait(1.5)
		local premium = H.UI.waitChild(chests, "Premium", 10)
		if premium then H.UI.clickGui(premium) end
	end
	local finish = H.UI.waitChild(chests, "Finish", 12) or (task.wait(2) and H.UI.waitChild(chests, "Finish", 8))
	if finish then H.UI.clickGui(finish) end
	return true
end

local REWARD_KEYS = { gold = "Gold", xp = "XP", gems = "Gems", gem = "Gems", canes = "Canes", cane = "Canes", spins = "Spins" }

local function collectRewards(obtained, drops, perks, totals, special, rarityOf)
	for key, amount in pairs(obtained or {}) do
		if type(amount) == "number" and amount > 0 then
			local lower = tostring(key):lower()
			if lower:find("gold") then H.Reward.updateStat("GoldCollected", (H.Stats.GoldCollected or 0) + amount)
			elseif lower == "xp" then H.Reward.updateStat("ExpCollected", (H.Stats.ExpCollected or 0) + amount)
			elseif lower:find("gem") then H.Reward.updateStat("GemsCollected", (H.Stats.GemsCollected or 0) + amount)
			elseif lower:find("cane") then H.Reward.updateStat("CanesCollected", (H.Stats.CanesCollected or 0) + amount) end
			local label = REWARD_KEYS[lower] or tostring(key)
			totals[label] = (totals[label] or 0) + amount
		end
	end
	for _, drop in ipairs(drops or {}) do
		local lower = tostring(drop):lower()
		totals[tostring(drop)] = (totals[tostring(drop)] or 0) + 1
		if lower:find("serum") then H.Reward.updateStat("TitanSerums", (H.Stats.TitanSerums or 0) + 1) special[#special + 1] = tostring(drop)
		elseif lower:find("scroll") then H.Reward.updateStat("PrestigeScrolls", (H.Stats.PrestigeScrolls or 0) + 1) special[#special + 1] = tostring(drop)
		elseif lower:find("shard") then H.Reward.updateStat("TitanShards", (H.Stats.TitanShards or 0) + 1) special[#special + 1] = tostring(drop)
		else H.Reward.updateStat("ItemDrops", (H.Stats.ItemDrops or 0) + 1) end
	end
	for _, perk in ipairs(perks or {}) do
		local lower = tostring(rarityOf and rarityOf(perk) or ""):lower()
		if lower:find("epic") then H.Reward.updateStat("EpicPerksCollected", (H.Stats.EpicPerksCollected or 0) + 1)
		elseif lower:find("legendary") then H.Reward.updateStat("LegendaryPerks", (H.Stats.LegendaryPerks or 0) + 1) special[#special + 1] = tostring(perk) .. " (Legendary)"
		elseif lower:find("mythic") then H.Reward.updateStat("MythicPerks", (H.Stats.MythicPerks or 0) + 1) special[#special + 1] = tostring(perk) .. " (Mythic)" end
	end
end

function H.Reward.onRewarded()
	if not workspace:GetAttribute("Rewarded") then return end
	local now = os.clock()
	if now - H.Runtime.rewardedTick < 5 then return end
	H.Runtime.rewardedTick = now
	local runType = workspace:GetAttribute("Type")
	local seconds = tonumber(workspace:GetAttribute("Seconds")) or 0

	task.spawn(function()
		H.Anti.resetBackoff()
		H.DataCopy.fetch(true)
		local deadline = os.clock() + 6
		while not H.RewardHook._get and os.clock() < deadline do task.wait(0.2) end
		local captured = H.RewardHook._get
		if not captured then
			local fallback = H.Net.actor("S_Rewards", "Get", {
				args = { true },
				map = [[
out = { obtained = {}, perks = {}, drops = {}, stats = {} }
if type(res) ~= "table" then return end
local ob = res.Obtained
if type(ob) == "table" then
    for k, v in pairs(ob) do
        if type(v) == "number" then out.obtained[tostring(k)] = v
        elseif k == "Perks" and type(v) == "table" then for _, pn in pairs(v) do out.perks[#out.perks + 1] = tostring(pn) end
        elseif k == "Drops" and type(v) == "table" then for _, dn in pairs(v) do out.drops[#out.drops + 1] = tostring(dn) end end
    end
end
if type(res.Stats) == "table" then
    for _, key in ipairs({ "Time_Taken", "Damage", "Kills", "Crits" }) do
        if type(res.Stats[key]) == "number" then out.stats[key] = res.Stats[key] end
    end
end
]],
				timeout = 6,
			})
			if fallback and fallback.ok and type(fallback.data) == "table" then captured = fallback.data end
		end

		local Perks
		pcall(function() Perks = require(RS.Modules.Storage.Perks) end)
		local function rarityOf(perk)
			if type(Perks) ~= "table" then return nil end
			for tier, bucket in pairs(Perks) do
				if type(bucket) == "table" and bucket[perk] ~= nil then return tostring(tier) end
			end
			return nil
		end

		local totals, special = {}, {}
		if captured then collectRewards(captured.obtained, captured.drops, captured.perks, totals, special, rarityOf) end
		if runType == "Missions" then H.Reward.updateStat("MissionsCompleted", (H.Stats.MissionsCompleted or 0) + 1)
		elseif runType == "Raids" then H.Reward.updateStat("RaidsCompleted", (H.Stats.RaidsCompleted or 0) + 1)
		elseif runType == "Waves" then H.Reward.updateStat("WavesCompleted", (H.Stats.WavesCompleted or 0) + 1) end

		if runType == "Raids" and H.Runtime.farming then
			H.Reward.openChests()
			local cd = os.clock() + 4
			while not H.RewardHook._chest and os.clock() < cd do task.wait(0.2) end
			if H.RewardHook._chest then collectRewards(H.RewardHook._chest.obtained, H.RewardHook._chest.drops, nil, totals, special, rarityOf) end
		end

		local stats = (captured and captured.stats) or {}
		H.StatsWebhook.checkEvents()
		H.StatsWebhook.sessionReport("win", runType, {
			rewards = totals, drops = special, seconds = seconds,
			kills = tonumber(stats.Kills), damage = tonumber(stats.Damage),
			difficulty = workspace:GetAttribute("Difficulty"), objective = workspace:GetAttribute("Objective"),
		})

		if (H.Config.WaveReturnLobby and runType == "Waves" or H.Lobby.thunderMode) and H.Runtime.farming then
			H.Farm.stop()
			task.delay(0.5, function() H.Farm.leaveToLobby(30) end)
			return
		end

		if H.Config.AutoLobby and H.Runtime.farming then
			H.Runtime.autoLobbyCount = H.Runtime.autoLobbyCount + 1
			if H.Runtime.autoLobbyCount >= H.Config.AutoLobbyAfter then
				H.Runtime.autoLobbyCount = 0
				H.Farm.stop()
				task.delay(0.5, function()
					if not H.Farm.leaveToLobby(30) then H.notify("Auto Farm", "Couldn't leave to lobby", 5, "alert-triangle") end
				end)
				return
			end
		end

		if not H.Runtime.farming then H.UI.refreshFarmStatus() return end
		H.Reward.waitForRewardsThen(function() H.Reward.clickRetrySure() end, 0)
		H.UI.refreshFarmStatus()
	end)
end

function H.Reward.onFailed()
	if not H.Runtime.farming then return end
	local now = os.clock()
	if now - H.Runtime.lastFailedTick < 3 then return end
	H.Runtime.lastFailedTick = now
	task.spawn(function()
		H.DataCopy.fetch(true)
		H.StatsWebhook.checkEvents()
		H.StatsWebhook.sessionReport("fail", workspace:GetAttribute("Type"))
	end)
	if H.Lobby.thunderMode then
		H.Farm.stop()
		task.delay(0.5, function() H.Farm.leaveToLobby(30) end)
		return
	end
	H.Reward.waitForRewardsThen(function()
		if workspace:GetAttribute("Type") == "Waves" and H.Config.WaveReturnLobby then
			H.Farm.stop()
			H.Farm.leaveToLobby(30)
		else
			H.Reward.clickRetrySure()
		end
	end, 0)
end

