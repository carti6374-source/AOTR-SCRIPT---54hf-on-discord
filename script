	if H.Runtime.farming then
		local elapsed = math.floor(os.clock() - H.Stats.FarmStartTime)
		H.UI.setParagraph(label, string.format("Time %dm %ds | Missions %d | Raids %d | Gold %d",
			math.floor(elapsed / 60), elapsed % 60, H.Stats.MissionsCompleted, H.Stats.RaidsCompleted, H.Stats.GoldCollected), "Farm — RUNNING")
	else
		H.UI.setParagraph(label, "Not farming", "Farm — IDLE")
