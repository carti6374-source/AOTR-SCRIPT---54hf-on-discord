function H.Prestige.runOnce()
	local snap = H.Prestige.snapshot()
	if not snap then return false, "no snapshot (enter a game first)" end
	if not snap.ready then return false, "not eligible" end
	local nextTier = (snap.prestige or 0) + 1
	if nextTier > H.Prestige.MAX_TIER then return false, "max prestige" end
	local cost = tonumber(H.Config.PrestigeGold[nextTier]) or 0
	if cost > 0 then
		local gold = H.Prestige.readGold()
		if not gold then return false, "gold unreadable" end
		if gold < cost then return false, string.format("gold %d/%d", gold, cost) end
	end

	local roll = H.Net.actor("S_Equipment", "Talents", {
		args = { nil },
		map = [[
local ids = b
if type(ids) ~= "table" then out = nil; return end
local Mem = require(game:GetService("ReplicatedStorage").Modules.Storage.Memories)
local root = Mem.Talents or Mem
local RANK = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4 }
local bestTag, bestRank
for _, id in ipairs(ids) do
    for tier, bucket in pairs(root) do
        local entry = type(bucket) == "table" and bucket[tostring(id)]
        if entry and entry.Tag then
            local r = RANK[tier] or 0
            if not bestRank or r > bestRank then bestTag, bestRank = entry.Tag, r end
        end
    end
end
out = bestTag and { tag = bestTag } or nil
]],
		timeout = 8,
	})
	if not (roll and roll.ok and type(roll.data) == "table" and roll.data.tag) then return false, "talents roll failed" end

	local boost = H.Prestige.BOOSTS[H.Config.PrestigeBoost[nextTier] or "Gold"] or "Gold Boost"
	local res = H.Net.actor("S_Equipment", "Prestige", {
		args = { { Boosts = boost, Talents = roll.data.tag } },
		map = "out = (res ~= nil)", timeout = 12,
	})
	if not (res and res.ok) then return false, "prestige invoke failed" end

	snap.prestige = nextTier
	snap.ready = nextTier < H.Prestige.MAX_TIER and snap.level >= H.Prestige.maxLevel(nextTier)
	return true, string.format("P%d -> %d (%s)", nextTier - 1, nextTier, boost)
end

