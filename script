H.task("AutoUpgrade", function(self)
	H.busy("AutoUpgrade")
	if not next(H.Stats.upgrades or {}) then H.DataCopy.fetch() end
	while not self.cancelled do
		if H.isInGame() then H.UI.gearStatus("Waiting (in game).") task.wait(3)
		elseif not H.Gear.upgradeAll(H.Lobby.autoUpgradeWeapon) then
			H.UI.gearStatus("Idle (gold or maxed).")
			break
		else H.UI.gearStatus("Upgraded " .. H.Lobby.autoUpgradeWeapon) task.wait(1) end
	end
	H.release("AutoUpgrade")
end)

H.task("AutoSkill", function(self)
	H.busy("AutoSkill")
	if H.isInGame() then H.UI.skillStatus("Lobby only.") H.release("AutoSkill") return end
	if not next(H.Stats.unlockedSkills or {}) then H.DataCopy.fetch() end
	local unlocked = {}
	for id in pairs(H.Stats.unlockedSkills or {}) do unlocked[tostring(id)] = true end
	local order, paths, perks = H.Skill.plan()

	local function highestLocked(ids)
		for i = #ids, 1, -1 do if not unlocked[ids[i]] then return i end end
		return 0
	end

	for _, perk in ipairs(perks) do
		if self.cancelled or H.isInGame() then break end
		local start = highestLocked(perk.ids)
		while start > 0 and not self.cancelled and not H.isInGame() do
			H.UI.skillStatus(perk.label .. " [" .. perk.ids[start] .. "]")
			local res = H.Skill.unlock({ perk.ids[start] })
			if not res then break end
			if res.success then for _, id in pairs(res.unlocked or {}) do unlocked[tostring(id)] = true end end
			start = start - 1
			task.wait(0.6)
		end
	end

	if H.Lobby.autoSkill.strategy == "Balanced" then
		local remaining = {}
		for _, path in ipairs(order) do
			local ids = paths[path]
			if ids then
				local start = highestLocked(ids)
				if start > 0 then remaining[#remaining + 1] = { path = path, ids = ids, index = start } end
			end
		end
		while not self.cancelled and not H.isInGame() and #remaining > 0 do
			local progressed = false
			for _, entry in ipairs(remaining) do
				if self.cancelled or H.isInGame() then break end
				if entry.index >= 1 then
					H.UI.skillStatus(entry.path .. " [" .. entry.ids[entry.index] .. "]")
					local res = H.Skill.unlock({ entry.ids[entry.index] })
					if res and res.success then
						for _, id in pairs(res.unlocked or {}) do unlocked[tostring(id)] = true end
						progressed = true
					end
					entry.index = entry.index - 1
					task.wait(0.6)
				end
			end
			local left = false
			for _, entry in ipairs(remaining) do if entry.index >= 1 then left = true break end end
			if not left or not progressed then break end
		end
	else
		for _, path in ipairs(order) do
			if self.cancelled or H.isInGame() then break end
			local ids = paths[path]
			if ids then
				H.UI.skillStatus(path)
				if not H.Skill.upgrade(ids) then break end
				task.wait(1)
			end
		end
	end
	H.UI.skillStatus("Idle.")
	H.release("AutoSkill")
end)

H.task("AutoDeletePerks", function(self)
	if game.PlaceId ~= H.PLACE.Lobby then return end
	if not H.Stats.perkStorage or #H.Stats.perkStorage == 0 then H.DataCopy.fetch() end
	if not H.Stats.perkStorage or #H.Stats.perkStorage == 0 then return end
	H.busy("AutoDeletePerks")
	local deleted = H.Perks.deleteByRarity()
	if deleted and deleted > 0 then
		local remove = {}
		for _, r in ipairs(H.selection(H.Config.DeletePerksRarities)) do remove[r] = true end
		local kept = {}
		for _, perk in ipairs(H.Stats.perkStorage or {}) do
			if not remove[perk.rarity] then kept[#kept + 1] = perk end
		end
		H.Stats.perkStorage = kept
	end
	H.release("AutoDeletePerks")
end)

