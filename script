function H.Skill.unlock(ids)
	local quoted = {}
	for _, id in ipairs(ids) do quoted[#quoted + 1] = string.format("%q", id) end
	local res = H.Net.actor("S_Equipment", "Unlock", {
		args = { loadstring_("return { " .. table.concat(quoted, ", ") .. " }")() },
		map = [[
local data, sp, err = a, b, c
local unlocked
if data and data.Slots and data.Current_Slot then
    local slot = data.Slots[data.Current_Slot]
    unlocked = slot and slot.Skills and slot.Skills.Unlocked
end
out = { success = data ~= nil, sp = sp, err = err, unlocked = unlocked }
]],
		timeout = 6,
	})
	if not res or not res.ok or type(res.data) ~= "table" then return nil end
	return res.data
end

function H.Skill.upgrade(ids)
	local queue = {}
	for i, id in ipairs(ids) do queue[i] = id end
	while #queue > 0 do
		local result = H.Skill.unlock(queue)
		if not result then return false end
		if result.success then return true, result.sp end
		if result.err == nil then return false end
		table.remove(queue, 1)
		task.wait(0.5)
	end
	return false
end

