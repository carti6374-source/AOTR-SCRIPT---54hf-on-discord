H.task("FamilySpin", function(self)
	H.busy("FamilySpin")
	local targets = H.Lobby.family.targets
	if #targets == 0 then H.UI.familyStatus("Select at least one family.") H.release("FamilySpin") return end
	local deadline = os.clock() + 15
	while not H.Family.panelOpen() and os.clock() < deadline and not self.cancelled do task.wait(0.5) end
	if self.cancelled then H.release("FamilySpin") return end
	if not H.Family.panelOpen() then H.UI.familyStatus("Open the Family panel first.") H.release("FamilySpin") return end
	while not self.cancelled and H.Family.panelOpen() do
