H.ESP = {}

function H.ESP.clear()
	H.disconnect("ESPAdd")
	H.disconnect("ESPRemove")
	if H.Cache.espFolder then pcall(function() H.Cache.espFolder:Destroy() end) end
	H.Cache.espFolder, H.Cache.espHighlights = nil, {}
